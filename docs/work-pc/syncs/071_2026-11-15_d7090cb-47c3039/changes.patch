-                            json.dumps(
-                                receipt, ensure_ascii=False, allow_nan=False, separators=(",", ":")
-                            )
-                        )
-                if receipt["status"] == "ok" and staged_cursor is not None:
-                    assert cursor_store is not None
-                    token, offset = staged_cursor
-                    cursor_store[token] = offset

+Cell = str | int | float | None
+Rows = dict[str, list[list[Cell]]]
+
+AS_OF = "2025-03-31"  # the synthetic launcher tests' run date (tests/test_cpos_launch.py AS_OF)
+FUND = "SYNTHETIC Example Credit Fund I (fictional)"
+

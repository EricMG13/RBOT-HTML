-class _Driver:
-    stage: Stage
-    settings: Settings
-    inputs: dict[str, CaseInputs]
-    adapters: dict[str, ModelAdapter]
-    settlements: tuple[Settlement, ...]
-    runs: list[tuple[RunMeta, tuple[CallRecord, ...]]]

+    (issue,) = ms.issues("CP-2E", text)
+    assert "T2F.4 row `Unhedged floating-rate debt` states 550 USD m" in issue
+    assert "recomputes 500 USD m" in issue and "rate_fx_sensitivity.py" in issue

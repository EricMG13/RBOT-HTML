+
+def _units(spec: Spec) -> None:  # class 12
+    _find(spec.constraints, "C-01")[6] = "~29.8%"
+    _find(spec.constraints, "C-02")[3] = "max 40 percent"
+    _find(spec.constraints, "C-03")[6] = "10.10"

+++ b/src/deploy_workflow/method_scripts_cp2e.py
@@ -0,0 +1,263 @@
+"""CP-2E's method script, `rate_fx_sensitivity.py`, run on T2F.4 and T2F.5 (harness:
+`deploy_workflow.method_scripts`).
+
+The method's step 4 (REF_CP-2E_04) makes T2F.4 carry the rows Total debt, Gross floating-rate debt,
+Hedged floating-rate debt, Unhedged floating-rate debt and Unhedged debt percentage; step 5
+(REF_CP-2E_05) makes T2F.5 carry the +100 bps cash-interest impact. T2F.4 has no currency or scale
+column, so each amount states its own (`USD 1,250m`), or the amount column's header does
+(`Amount (USD m)`); a cell's own unit wins. FX and cost sensitivities are not checked: their net
+exposure and adverse move are free text in T2F.6 and T2F.7, not columns.
+"""
+
+import types
+from dataclasses import dataclass, replace
+from typing import Any
+
+from deploy_workflow import method_scripts as core
+from deploy_workflow.method_scripts import (
+    AMOUNT_STEP,
+    ARCHIVE,
+    Amount,
+    Loaded,
+    Outcome,
+    Table,
+    Upstream,
+    _Claim,
+    _judged,
+    _label,
+    _NotChecked,
+    _Where,
+    bare,
+    blank,
+    column,
+    money,
+    quotient_slack,
+    register_table,
+    share,
+)
+
+RATE_FX = ARCHIVE + "skills/cp-2e-macro-fx-hedging-sensitivity/scripts/rate_fx_sensitivity.py"
+TOTAL = "Total debt"
+GROSS = "Gross floating-rate debt"
+HEDGED = "Hedged floating-rate debt"
+UNHEDGED = "Unhedged floating-rate debt"
+SHARE = "Unhedged debt percentage"
+SHOCK = "+100 bps cash-interest impact"
+EXPOSURE_ROWS = (TOTAL, GROSS, HEDGED, UNHEDGED, SHARE)  # REF_CP-2E_04 instruction 2
+UNHEDGED_FORMULA = (
+    "Unhedged floating-rate debt = Gross floating-rate debt - Hedged floating-rate debt "
+    "(REF_CP-2E_04)"
+)
+SHARE_FORMULA = "Unhedged debt percentage = Unhedged floating-rate debt / Total debt (REF_CP-2E_04)"
+SHOCK_FORMULA = (
+    "+100 bps cash-interest impact = (Gross floating-rate debt - Hedged floating-rate debt) x "
+    "1.00% (REF_CP-2E_05)"
+)
+CP2E_NOTE = (
+    "Python checks three of your figures after you answer, with the method's own "
+    "`rate_fx_sensitivity.py` (you cannot run it): in T2F.4, Unhedged floating-rate debt and "
+    "Unhedged debt percentage, from its Total debt, Gross floating-rate debt and Hedged "
+    "floating-rate debt rows; in T2F.5, the Estimated Cash Impact of the `+100 bps cash-interest "
+    "impact` row. Write those rows once each with these names, every amount with its currency "
+    "and scale (`USD 1,250m`) and the percentage with `%`. A figure that disagrees is sent back "
+    "for repair; one whose input is missing is not checked, never read as zero.\n\n"
+)
+_UNHEDGED = _Where("CP-2E", RATE_FX, UNHEDGED, "T2F.4")
+_SHARE = _Where("CP-2E", RATE_FX, SHARE, "T2F.4")
+_SHOCK = _Where("CP-2E", RATE_FX, SHOCK, "T2F.5")
+
+
+def _rows(table: Table, item: int, names: tuple[str, ...], where: str) -> dict[str, list[str]]:
+    wanted = {_label(n): n for n in names}
+    rows: dict[str, list[str]] = {}
+    for row in table[1]:
+        name = wanted.get(_label(row[item]))
+        if name is not None and name in rows:
+            raise _NotChecked(f"{where} has two `{name}` rows")
+        if name is not None:
+            rows[name] = row
+    return rows
+
+
+@dataclass(frozen=True)
+class _Exposure:
+    """T2F.4 as the script reads it, and the two figures it states."""
+
+    amounts: dict[str, Amount | str]  # Total, Gross, Hedged, Unhedged rows present (str: unread)
+    share: str | None  # the Unhedged debt percentage cell as written
+    unit: str
+
+
+def _exposure(text: str, tables: types.ModuleType) -> _Exposure:
+    table = register_table(text, "T2F.4")
+    if isinstance(table, str):
+        raise _NotChecked(table)
+    metric = column(table, "metric", "T2F.4")[0]
+    amount, header = column(table, "amount", "T2F.4")
+    rows = _rows(table, metric, EXPOSURE_ROWS, "T2F.4")
+    amounts = {n: _read(r[amount], header, tables) for n, r in rows.items() if n != SHARE}
+    read = [a for a in amounts.values() if isinstance(a, Amount) and a.unit is not None]
+    units = {str(a.unit) for a in read}
+    if len(units) > 1:
+        shown = "; ".join(f"`{a.cell}`" for a in read)
+        raise _NotChecked(f"T2F.4's amounts state different currencies or scales: {shown}")
+    share = rows[SHARE][amount] if SHARE in rows else None
+    return _Exposure(amounts, share, units.pop() if units else "")
+
+
+def _read(cell: str, header: str, tables: types.ModuleType) -> Amount | str:
+    """An amount, or why it is not read: an unread row stops only the checks that use it."""
+    try:
+        return money(cell, header, tables)
+    except _NotChecked as why:
+        return str(why)
+
+
+def _inputs(exposure: _Exposure) -> dict[str, float | None]:
+    values = {n: a.value for n, a in exposure.amounts.items() if isinstance(a, Amount)}
+    return {
+        "total_debt": values.get(TOTAL),
+        "gross_floating_rate_debt": values.get(GROSS),
+        "hedged_floating_rate_debt": values.get(HEDGED),
+    }
+
+
+def _missing(exposure: _Exposure, names: tuple[str, ...]) -> str | None:
+    absent = [n for n in names if n not in exposure.amounts]
+    if absent:
+        return f"T2F.4 has no {', '.join(f'`{n}`' for n in absent)} row (absent, not zero)"
+    unread = [a for n in names if isinstance(a := exposure.amounts[n], str)]
+    if unread:
+        return unread[0]
+    blanks = [n for n in names if _value(exposure, n) is None]
+    if blanks:
+        return (
+            f"T2F.4 states no amount for {', '.join(f'`{n}`' for n in blanks)} (missing, not zero)"
+        )
+    return None
+
+
+def _value(exposure: _Exposure, name: str) -> float | None:
+    amount = exposure.amounts.get(name)
+    return amount.value if isinstance(amount, Amount) else None
+
+
+def _half(exposure: _Exposure, *names: str) -> float:
+    """The summed half-last-place rounding of the named amounts (their displayed precision)."""
+    return sum(a.half for n in names if isinstance(a := exposure.amounts.get(n), Amount))
+
+
+def _unhedged(exposure: _Exposure, result: dict[str, Any], tables: types.ModuleType) -> Outcome:
+    stated = exposure.amounts.get(UNHEDGED)
+    if isinstance(stated, str):
+        return _UNHEDGED("not checked", reason=stated)
+    if stated is None or stated.value is None:
+        cell = None if stated is None else stated.cell
+        return _UNHEDGED("not checked", stated=cell, reason=f"T2F.4 states no {UNHEDGED} figure")
+    gap = _missing(exposure, (GROSS, HEDGED))
+    if gap is not None:
+        return _UNHEDGED("not checked", stated=stated.cell, reason=gap)
+    recomputed = result["unhedged_floating_rate_debt"]
+    claim = _Claim(
+        _UNHEDGED, bare(stated.cell), recomputed, AMOUNT_STEP, exposure.unit, UNHEDGED_FORMULA
+    )
+    return _judged(replace(claim, slack=_half(exposure, GROSS, HEDGED)), tables)
+
+
+def _share(exposure: _Exposure, result: dict[str, Any], tables: types.ModuleType) -> Outcome:
+    cell = exposure.share
+    if cell is None or blank(cell, tables):
+        return _SHARE("not checked", stated=cell, reason=f"T2F.4 states no {SHARE} figure")
+    gap = _missing(exposure, (TOTAL, GROSS, HEDGED))
+    if gap is not None:
+        return _SHARE("not checked", stated=cell, reason=gap)
+    recomputed = result["unhedged_debt_percentage"]
+    if recomputed is None:
+        reason = "Total debt is zero, so the script gives no percentage"
+        return _SHARE("not checked", stated=cell, reason=reason)
+    unhedged = float(result["unhedged_floating_rate_debt"])
+    total = float(_value(exposure, TOTAL) or 0.0)
+    slack = quotient_slack(unhedged, _half(exposure, GROSS, HEDGED), total, _half(exposure, TOTAL))
+    claim = _Claim(_SHARE, cell, recomputed, AMOUNT_STEP, "", SHARE_FORMULA, slack=slack)
+    return share(claim, tables)
+
+
+def _shock_cell(text: str, tables: types.ModuleType) -> Amount:
+    table = register_table(text, "T2F.5")
+    if isinstance(table, str):
+        raise _NotChecked(table)
+    item = column(table, "sensitivity", "T2F.5")[0]
+    impact, header = column(table, "estimated cash impact", "T2F.5")
+    rows = [r for r in table[1] if _label(r[item]).lstrip("+ ") == _label(SHOCK).lstrip("+ ")]
+    if len(rows) != 1:
+        raise _NotChecked(f"T2F.5 has {len(rows) or 'no'} `{SHOCK}` rows")
+    return money(rows[0][impact], header, tables)
+
+
+def _shock(
+    text: str, exposure: _Exposure, result: dict[str, Any], tables: types.ModuleType
+) -> Outcome:
+    try:
+        stated = _shock_cell(text, tables)
+    except _NotChecked as why:
+        return _SHOCK("not checked", reason=str(why))
+    if stated.value is None:
+        return _SHOCK("not checked", stated=stated.cell, reason=f"T2F.5 states no {SHOCK} figure")
+    gap = _missing(exposure, (GROSS, HEDGED))
+    if gap is not None:
+        return _SHOCK("not checked", stated=stated.cell, reason=gap)
+    if exposure.unit and stated.unit != exposure.unit:
+        reason = f"T2F.5's impact is in `{stated.unit}`, T2F.4's amounts in `{exposure.unit}`"
+        return _SHOCK("not checked", stated=stated.cell, reason=reason)
+    recomputed = result["cash_interest_impact_plus_100bps"]
+    # Neither the method nor the note fixes this cell's sign: an increase in cash interest may be
+    # written as an outflow. The magnitude is compared and the stated sign kept in the record.
+    written = bare(stated.cell)
+    size = written.strip("()").lstrip("-+").strip() if stated.value < 0 else written
+    slack = 0.01 * _half(exposure, GROSS, HEDGED)  # BPS_SHOCK times the inputs' rounding
+    claim = _Claim(_SHOCK, size, recomputed, AMOUNT_STEP, str(stated.unit), SHOCK_FORMULA)
+    outcome = _judged(replace(claim, slack=slack), tables)
+    if stated.value >= 0:
+        return outcome
+    sign = "; compared as a magnitude: the cell writes the impact as an outflow (negative)"
+    return replace(outcome, stated=written, reason=outcome.reason + sign)
+
+
+_HEDGE_PAIR = _Where("CP-2E", RATE_FX, f"{HEDGED} against {GROSS}", "T2F.4")
+
+
+def _contradiction(exposure: _Exposure, error: ValueError) -> list[Outcome]:
+    """Hedged floating-rate debt above gross: the two rows contradict each other (the script:
+    "perimeters differ or a hedge is double-counted"). Sent back (owner, 2026-11-15:
+    "approved"); any other refusal of the script is only not checked."""
+    gross, hedged = _value(exposure, GROSS), _value(exposure, HEDGED)
+    over = gross is not None and hedged is not None and 0 <= gross < hedged
+    if not over or "exceeds gross floating-rate debt" not in str(error):  # the script's own words
+        return []
+    cells = {n: a.cell for n in (HEDGED, GROSS) if isinstance(a := exposure.amounts[n], Amount)}
+    stated = f"{HEDGED} `{cells[HEDGED]}` above {GROSS} `{cells[GROSS]}`"
+    return [_HEDGE_PAIR("contradicted", stated=stated, unit=exposure.unit, reason=str(error))]
+
+
+def check(text: str, loaded: Loaded, _upstream: Upstream) -> list[Outcome]:
+    """Unhedged floating-rate debt and its share of total debt (T2F.4) and the +100 bps
+    cash-interest impact (T2F.5), each recomputed by the script from T2F.4's own rows."""
+    tables = loaded.tables
+    try:
+        exposure = _exposure(text, tables)
+    except _NotChecked as why:
+        return [w("not checked", reason=str(why)) for w in (_UNHEDGED, _SHARE, _SHOCK)]
+    try:
+        result = loaded.script.compute(_inputs(exposure))
+    except ValueError as error:  # the script refuses: hedged above gross, a negative amount
+        cause = f"the script refused T2F.4's inputs: {error}"
+        refused = [w("not checked", reason=cause) for w in (_UNHEDGED, _SHARE, _SHOCK)]
+        return [*_contradiction(exposure, error), *refused]
+    return [
+        _unhedged(exposure, result, tables),
+        _share(exposure, result, tables),
+        _shock(text, exposure, result, tables),
+    ]
+
+
+core.register("CP-2E", RATE_FX, check, CP2E_NOTE)
diff --git a/src/deploy_workflow/method_scripts_cp2g.py b/src/deploy_workflow/method_scripts_cp2g.py
new file mode 100644
index 0000000..dcd12cf
--- /dev/null
+++ b/src/deploy_workflow/method_scripts_cp2g.py
@@ -0,0 +1,467 @@
+"""CP-2G's method script, `credit_metrics.py`, run on T2H.4, T2H.5 and T2H.6 (harness:
+`deploy_workflow.method_scripts`).
+
+The SKILL gives the script "per-period KPIs on each case and the opening-to-closing roll-forward
+with its residual". The registers (SKILL `appendix_contract`) are, per period and case: T2H.4
+`EBITDA`, `FCF`; T2H.5 `opening debt/cash`, `issuance`, `repayment`, `interest`, `closing
+debt/cash`; T2H.6 `gross/net leverage`, `coverage`, `FCF/debt`, `definition IDs`.
+
+Combined cells. A column whose name joins two figures with `/` (`opening debt/cash`, `closing
+debt/cash`, `gross/net leverage`) holds two figures separated by `/`, in the order the name gives
+them (`4,500 / 300`, `4.5x / 4.2x`). A cell that is a gap as a whole leaves both missing; one side
+that is a gap leaves that side missing; a cell that is not two parts states neither figure.
+
+Units. T2H.4 and T2H.5 have no currency or scale column: each money column's header states it
+(`EBITDA (USD m)`), or each cell does (`USD 4,500m`). Every money figure read must be in one
+currency and scale, or nothing is compared.
+
+What is checked, per T2H.6 row: gross leverage = closing debt / EBITDA; net leverage = (closing
+debt - closing cash) / EBITDA (both against a positive EBITDA, annual periods only: a quarter's
+EBITDA is not a leverage denominator); coverage = EBITDA / |interest|, compared as a disagreement
+only when the row's definition names EBITDA over interest (the method allows interest or
+fixed-charge coverage); FCF/debt = FCF / closing debt (annual only). Per T2H.5 row: the opening
+debt and cash equal the same case's prior closing (the row before it in T2H.5, compared only
+when both are annual periods whose years are consecutive), a disagreement otherwise; and closing
+debt = opening debt + issuance - repayment (each as its size), agreed when it rolls, otherwise not
+checked with the residual, because the method allows a logged residual and T2H.5 has no column for
+other debt movements (PIK, FX, accretion). The cash roll-forward is not checked: dividends and
+other cash uses are not columns.
+"""
+
+import re
+import types
+from dataclasses import dataclass, replace
+
+from deploy_workflow import method_scripts as core
+from deploy_workflow.method_scripts import (
+    AMOUNT_STEP,
+    ARCHIVE,
+    Amount,
+    Loaded,
+    Outcome,
+    Table,
+    Upstream,
+    _Claim,
+    _judged,
+    _label,
+    _NotChecked,
+    _plain,
+    _Where,
+    bare,
+    blank,
+    column,
+    money,
+    quotient_slack,
+    register_table,
+    said_none,
+    share,
+)
+
+CREDIT_METRICS = ARCHIVE + "skills/cp-1-canonical-data-foundation/scripts/credit_metrics.py"
+# Each register's money columns (SKILL appendix_contract) -> the field(s) each holds, in order.
+T2H4_MONEY = {"EBITDA": ("ebitda",), "FCF": ("fcf",)}
+T2H5_MONEY = {
+    "opening debt/cash": ("opening_debt", "opening_cash"),
+    "issuance": ("issuance",),
+    "repayment": ("repayment",),
+    "interest": ("interest",),
+    "closing debt/cash": ("closing_debt", "closing_cash"),
+}
+RATIO_STEP = 1e-9  # the script does not round its ratios
+_PART = re.compile(r"\s*/\s*")
+_NOT_ANNUAL = re.compile(r"\b(?:q[1-4]|h[12]|[1-9]m|quarter|half|month|ytd)\b")
+_OTHER_BASIS = re.compile(
+    r"covenant|agency|rating|lease[ -]?adjusted|ifrs ?16|pro ?forma|run[ -]?rate|principal|"
+    r"face value|average debt"
+)
+_EBITDA_OVER_INTEREST = re.compile(r"ebitda\s*(?:/|to|over)\s*(?:\(?cash\s+|net\s+)?interest")
+CP2G_NOTE = (
+    "Python checks figures in T2H.5 and T2H.6 after you answer, with the method's own "
+    "`credit_metrics.py` (you cannot run it): per period and case, gross and net leverage "
+    "(closing debt, and closing debt less closing cash, over T2H.4 EBITDA), coverage (EBITDA / "
+    "cash interest), FCF/debt, and that each opening debt and cash is the case's prior closing. "
+    "So give T2H.4, T2H.5 and T2H.6 the method's columns with the same period and case labels, "
+    "put the currency and scale in each money column's header (`EBITDA (USD m)`), and write each "
+    "combined cell as two figures in its column's order (`4,500 / 300`, `4.5x / 4.2x`). A figure "
+    "that disagrees is sent back for repair; one whose input is missing is not checked, never "
+    "read as zero.\n\n"
+)
+
+Key = tuple[str, str]  # (period, case) as labelled
+Field = Amount | str  # a money figure as read, or why its cell is not read
+
+
+@dataclass(frozen=True)
+class _Kpi:
+    """One T2H.6 figure: the script's KPI, its inputs, and the formula in words."""
+
+    name: str
+    kpi: str
+    inputs: tuple[str, ...]
+    formula: str
+    annual: bool  # a leverage or FCF/debt figure needs an annual period
+
+
+KPIS = (
+    _Kpi(
+        "Gross leverage",
+        "total_leverage",
+        ("closing_debt", "ebitda"),
+        "Gross leverage = closing debt (T2H.5) / EBITDA (T2H.4), EBITDA positive",
+        True,
+    ),
+    _Kpi(
+        "Net leverage",
+        "net_leverage",
+        ("closing_debt", "closing_cash", "ebitda"),
+        "Net leverage = (closing debt - closing cash) (T2H.5) / EBITDA (T2H.4), EBITDA positive",
+        True,
+    ),
+    _Kpi(
+        "Coverage",
+        "interest_coverage",
+        ("ebitda", "interest"),
+        "Coverage = EBITDA (T2H.4) / |interest| (T2H.5), interest not zero",
+        False,
+    ),
+    _Kpi(
+        "FCF/debt",
+        "fcf_percent_debt",
+        ("fcf", "closing_debt"),
+        "FCF/debt = FCF (T2H.4) / closing debt (T2H.5)",
+        True,
+    ),
+)
+
+
+def _where(register: str, figure_name: str, key: Key) -> _Where:
+    return _Where("CP-2G", CREDIT_METRICS, f"{figure_name} ({key[0]}, {key[1]})", register)
+
+
+def _split(cell: str, tables: types.ModuleType) -> tuple[str, str] | None:
+    """A combined cell's two parts in order, a whole gap as two gaps, or None (not two parts)."""
+    if blank(cell, tables):
+        return cell, cell
+    parts = _PART.split(re.sub(r"(?i)\bn/a\b", "na", _plain(cell)))
+    return (parts[0], parts[1]) if len(parts) == 2 else None
+
+
+def _money(cell: str, header: str, tables: types.ModuleType) -> Field:
+    try:
+        return money(cell, header, tables)
+    except _NotChecked as why:
+        return str(why)
+
+
+def _fields(
+    row: list[str], spec: dict[str, tuple[int, str]], tables: types.ModuleType
+) -> dict[str, Field]:
+    out: dict[str, Field] = {}
+    for name, (index, header) in spec.items():
+        keys = (T2H4_MONEY | T2H5_MONEY)[name]
+        if len(keys) == 1:
+            out[keys[0]] = _money(row[index], header, tables)
+            continue
+        parts = _split(row[index], tables)
+        if parts is None:
+            why = f"`{row[index]}` is not two figures as its column `{name}` names them"
+            out |= dict.fromkeys(keys, why)
+        else:
+            out |= {k: _money(p, header, tables) for k, p in zip(keys, parts, strict=True)}
+    return out
+
+
+def _keyed(table: Table, where: str) -> dict[Key, list[str]]:
+    period = column(table, "period", where)[0]
+    case = column(table, "case", where)[0]
+    rows: dict[Key, list[str]] = {}
+    for row in table[1]:
+        key = (_plain(row[period]), _plain(row[case]))
+        if (_label(key[0]), _label(key[1])) in {(_label(a), _label(b)) for a, b in rows}:
+            raise _NotChecked(f"{where} has two rows for {key[0]}, {key[1]}")
+        rows[key] = row
+    return rows
+
+
+@dataclass(frozen=True)
+class _Model:
+    """T2H.4 and T2H.5 as the script reads them, by (period, case)."""
+
+    fields: dict[Key, dict[str, Field]]
+    order: dict[str, list[Key]]  # case -> its T2H.5 rows in order
+    unit: str
+
+
+def _model(text: str, tables: types.ModuleType) -> _Model:
+    fields: dict[Key, dict[str, Field]] = {}
+    order: dict[str, list[Key]] = {}
+    for ident, spec in (("T2H.4", T2H4_MONEY), ("T2H.5", T2H5_MONEY)):
+        table = register_table(text, ident)
+        if isinstance(table, str):
+            raise _NotChecked(table)
+        rows = _keyed(table, ident)
+        cols = {name: column(table, name, ident) for name in spec}
+        for key, row in rows.items():
+            fields.setdefault(_norm(key), {}).update(_fields(row, cols, tables))
+            if ident == "T2H.5":
+                order.setdefault(_label(key[1]), []).append(key)
+    units = {f.unit for row in fields.values() for f in row.values() if isinstance(f, Amount)}
+    units.discard(None)
+    if len(units) > 1:
+        raise _NotChecked(
+            f"T2H.4 and T2H.5 state money in different units: {sorted(map(str, units))}"
+        )
+    return _Model(fields, order, str(units.pop()) if units else "")
+
+
+def _norm(key: Key) -> Key:
+    return _label(key[0]), _label(key[1])
+
+
+def _inputs(model: _Model, key: Key, names: tuple[str, ...]) -> dict[str, float] | str:
+    """The named inputs of one period and case, or why one is not read (missing is not zero)."""
+    row = model.fields.get(_norm(key))
+    if row is None:
+        return f"T2H.4 and T2H.5 have no row for {key[0]}, {key[1]}"
+    values: dict[str, float] = {}
+    for name in names:
+        field = row.get(name)
+        what = f"{name.replace('_', ' ')} for {key[0]}, {key[1]}"
+        if field is None:
+            return f"{_register_of(name)} has no {what}"
+        if isinstance(field, str):
+            return field
+        if field.value is None:
+            return f"{_register_of(name)} states no {what} (missing, not zero)"
+        values[name] = field.value
+    return values
+
+
+def _halves(model: _Model, key: Key) -> dict[str, float]:
+    """Each read input's half-last-place rounding for one period and case."""
+    row = model.fields.get(_norm(key), {})
+    return {name: f.half for name, f in row.items() if isinstance(f, Amount)}
+
+
+def _kpi_slack(kpi: str, v: dict[str, float], h: dict[str, float]) -> float:
+    """The first-order bound the inputs' displayed rounding puts on the script's KPI."""
+    debt, ebitda = v.get("closing_debt", 0.0), v.get("ebitda", 0.0)
+    hd, he = h.get("closing_debt", 0.0), h.get("ebitda", 0.0)
+    if kpi == "total_leverage":
+        return quotient_slack(debt, hd, ebitda, he)
+    if kpi == "net_leverage":
+        net, hn = debt - v.get("closing_cash", 0.0), hd + h.get("closing_cash", 0.0)
+        return quotient_slack(net, hn, ebitda, he)
+    if kpi == "interest_coverage":
+        return quotient_slack(ebitda, he, abs(v.get("interest", 0.0)), h.get("interest", 0.0))
+    return quotient_slack(v.get("fcf", 0.0), h.get("fcf", 0.0), debt, hd)
+
+
+def _register_of(name: str) -> str:
+    return "T2H.4" if name in ("ebitda", "fcf") else "T2H.5"
+
+
+# --- T2H.6: the KPIs ----------------------------------------------------------------------------
+
+
+def _stated_kpis(
+    row: list[str], cols: dict[str, int], tables: types.ModuleType
+) -> dict[str, str | None]:
+    pair = _split(row[cols["gross/net leverage"]], tables)
+    gross, net = pair if pair is not None else (None, None)
+    return {
+        "Gross leverage": gross,
+        "Net leverage": net,
+        "Coverage": row[cols["coverage"]],
+        "FCF/debt": row[cols["FCF/debt"]],
+    }
+
+
+def _kpi(kpi: _Kpi, key: Key, stated: str | None, model: _Model, loaded: Loaded) -> Outcome:
+    where = _where("T2H.6", kpi.name, key)
+    if stated is None:
+        return where("not checked", reason="T2H.6's `gross/net leverage` cell is not two figures")
+    none = said_none(stated)
+    if blank(stated, loaded.tables) and not none:
+        return where("not checked", stated=stated, reason=f"T2H.6 states no {kpi.name} figure")
+    if kpi.annual and _NOT_ANNUAL.search(_label(key[0])):
+        reason = f"{key[0]} is not an annual period: its EBITDA or FCF is not a full year's"
+        return where("not checked", stated=stated, reason=reason)
+    inputs = _inputs(model, key, kpi.inputs)
+    if isinstance(inputs, str):
+        return where("not checked", stated=stated, reason=inputs)
+    names = {"closing_debt": "total_debt", "closing_cash": "cash_and_equivalents"}
+    names |= {"interest": "cash_interest_paid"}
+    value = loaded.script.compute_kpis({names.get(k, k): v for k, v in inputs.items()})[kpi.kpi]
+    if value is None or none:
+        agreed = value is None and none
+        label = "Not Calculable" if value is None else None
+        return where(
+            "agreed" if agreed else "disagreed",
+            stated=stated,
+            recomputed=value,
+            recomputed_label=label,
+            reason=kpi.formula,
+        )
+    slack = _kpi_slack(kpi.kpi, inputs, _halves(model, key))
+    claim = _Claim(where, stated, value, RATIO_STEP, "x", kpi.formula, slack=slack)
+    return _ratio(kpi, claim, loaded.tables)
+
+
+def _coverage_defined(outcome: Outcome, definition: str) -> Outcome:
+    """A coverage that is not EBITDA / interest disagrees only when the row says that is its
+    definition; otherwise it may be another coverage the method allows."""
+    if outcome.status != "disagreed" or _EBITDA_OVER_INTEREST.search(_label(definition)):
+        return outcome
+    reason = (
+        "the stated coverage is not EBITDA / |interest| and the row's definition does not say it "
+        "is; it may be fixed-charge or EBITDA-less-capex coverage, which T2H.4 and T2H.5 cannot "
+        "recompute"
+    )
+    return replace(outcome, status="not checked", reason=reason)
+
+
+def _ratio(kpi: _Kpi, claim: _Claim, tables: types.ModuleType) -> Outcome:
+    if kpi.name == "FCF/debt":
+        return share(claim, tables)
+    multiple = re.sub(r"(?i)\s*x(?=\)?$)", "", _plain(claim.stated))  # `4.5x` is 4.5, unit x
+    return _judged(replace(claim, stated=multiple), tables)
+
+
+def _basis_defined(outcome: Outcome, definition: str) -> Outcome:
+    """A leverage or FCF/debt figure that disagrees is not sent back when the row's definition
+    names another basis than closing debt over the period's EBITDA (covenant or agency EBITDA,
+    lease-adjusted, pro forma); the method keeps such definitions apart (REF_CP-2G_B)."""
+    other = _OTHER_BASIS.search(_label(definition))
+    if outcome.status != "disagreed" or other is None:
+        return outcome
+    reason = f"the row's definition (`{other[0]}`) is not the script's closing debt / EBITDA"
+    return replace(outcome, status="not checked", reason=reason)
+
+
+def _kpis(text: str, model: _Model, loaded: Loaded) -> list[Outcome]:
+    table = register_table(text, "T2H.6")
+    if isinstance(table, str):
+        return [_Where("CP-2G", CREDIT_METRICS, "T2H.6", "T2H.6")("not checked", reason=table)]
+    names = ("gross/net leverage", "coverage", "FCF/debt", "definition IDs")
+    try:  # an unread T2H.6 leaves T2H.5's roll-forward checked
+        rows = _keyed(table, "T2H.6")
+        cols = {name: column(table, name, "T2H.6")[0] for name in names}
+    except _NotChecked as why:
+        return [_Where("CP-2G", CREDIT_METRICS, "T2H.6", "T2H.6")("not checked", reason=str(why))]
+    out = []
+    for key, row in rows.items():
+        stated = _stated_kpis(row, cols, loaded.tables)
+        definition = f"{row[cols['definition IDs']]} {table[0][cols['coverage']]}"
+        outcomes = [_kpi(k, key, stated[k.name], model, loaded) for k in KPIS]
+        out += [
+            _coverage_defined(o, definition)
+            if o.figure.startswith("Coverage")
+            else _basis_defined(o, row[cols["definition IDs"]])
+            for o in outcomes
+        ]
+    return out
+
+
+# --- T2H.5: the roll-forward --------------------------------------------------------------------
+
+OPENING_FORMULA = (
+    "Opening {what} = the same case's closing {what} in the period before it in T2H.5 (CP-2G: "
+    "'Reconcile opening balances to the prior closing period')"
+)
+CLOSING_FORMULA = "Closing debt = opening debt + issuance - repayment (T2H.5)"
+
+
+def _year(period: str) -> int | None:
+    """The fiscal year an annual period names (`FY2026`, `2026E`, `FY26`); None for any other."""
+    label = _label(period)
+    if _NOT_ANNUAL.search(label):
+        return None
+    found = re.search(r"(?<!\d)(\d{4})(?!\d)|\bfy\s*(\d{2})(?!\d)", label)
+    if found is None:
+        return None
+    return int(found[1]) if found[1] else 2000 + int(found[2])
+
+
+def _follows(period: str, prior: str) -> bool:
+    """Whether ``period`` is the annual period right after ``prior`` (a row before it in T2H.5
+    is not taken as its prior period on order alone)."""
+    year, before = _year(period), _year(prior)
+    return year is not None and before is not None and year == before + 1
+
+
+def _opening(what: str, key: Key, prior: Key | None, model: _Model, loaded: Loaded) -> Outcome:
+    where = _where("T2H.5", f"Opening {what}", key)
+    field = model.fields[_norm(key)].get(f"opening_{what}")
+    if not isinstance(field, Amount) or field.value is None:
+        reason = field if isinstance(field, str) else f"T2H.5 states no opening {what}"
+        return where("not checked", reason=reason)
+    if prior is None or not _follows(key[0], prior[0]):
+        reason = f"T2H.5 shows no year that {key[0]} follows in case {key[1]}"
+        return where("not checked", stated=bare(field.cell), reason=reason)
+    inputs = _inputs(model, prior, (f"closing_{what}",))
+    if isinstance(inputs, str):
+        return where("not checked", stated=bare(field.cell), reason=inputs)
+    rolled = loaded.script.roll_forward(inputs[f"closing_{what}"], [], field.value)
+    formula = OPENING_FORMULA.format(what=what)
+    claim = _Claim(
+        where, bare(field.cell), rolled["expected_closing"], AMOUNT_STEP, model.unit, formula
+    )
+    prior_half = _halves(model, prior).get(f"closing_{what}", 0.0)  # the prior close's rounding
+    return _judged(replace(claim, slack=prior_half), loaded.tables)
+
+
+def _closing(key: Key, model: _Model, loaded: Loaded) -> Outcome:
+    where = _where("T2H.5", "Closing debt", key)
+    names = ("opening_debt", "issuance", "repayment", "closing_debt")
+    inputs = _inputs(model, key, names)
+    if isinstance(inputs, str):
+        return where("not checked", reason=inputs)
+    flows = [abs(inputs["issuance"]), -abs(inputs["repayment"])]
+    rolled = loaded.script.roll_forward(inputs["opening_debt"], flows, inputs["closing_debt"])
+    stated = bare(_cell(model, key, "closing_debt"))
+    claim = _Claim(
+        where, stated, rolled["expected_closing"], AMOUNT_STEP, model.unit, CLOSING_FORMULA
+    )
+    flows_half = sum(_halves(model, key).get(n, 0.0) for n in names[:3])
+    outcome = _judged(replace(claim, slack=flows_half), loaded.tables)
+    if outcome.status == "disagreed":
+        reason = (
+            f"a residual of {rolled['residual']:g}: the method allows a residual it logs, and "
+            "T2H.5 has no column for other debt movements (PIK, FX, accretion)"
+        )
+        return replace(outcome, status="not checked", reason=reason)
+    return outcome
+
+
+def _cell(model: _Model, key: Key, name: str) -> str:
+    field = model.fields[_norm(key)][name]
+    return field.cell if isinstance(field, Amount) else field
+
+
+def _rolls(model: _Model, loaded: Loaded) -> list[Outcome]:
+    out = []
+    for keys in model.order.values():
+        for i, key in enumerate(keys):
+            prior = keys[i - 1] if i else None
+            out += [
+                _opening("debt", key, prior, model, loaded),
+                _opening("cash", key, prior, model, loaded),
+                _closing(key, model, loaded),
+            ]
+    return out
+
+
+def check(text: str, loaded: Loaded, _upstream: Upstream) -> list[Outcome]:
+    """Leverage, coverage and FCF/debt per period and case (T2H.6) and the debt roll-forward
+    (T2H.5), each recomputed by the script from T2H.4 and T2H.5."""
+    try:
+        model = _model(text, loaded.tables)
+        return [*_kpis(text, model, loaded), *_rolls(model, loaded)]
+    except _NotChecked as why:
+        return [
+            _Where("CP-2G", CREDIT_METRICS, "all", "T2H.4-T2H.6")("not checked", reason=str(why))
+        ]
+
+
+core.register("CP-2G", CREDIT_METRICS, check, CP2G_NOTE)
diff --git a/src/deploy_workflow/method_scripts_cp3.py b/src/deploy_workflow/method_scripts_cp3.py
new file mode 100644
index 0000000..744b9a4
--- /dev/null
+++ b/src/deploy_workflow/method_scripts_cp3.py
@@ -0,0 +1,363 @@
+"""CP-3's method scripts on its `### Recovery waterfall` table (harness:
+`deploy_workflow.method_scripts`): `recovery_waterfall.py` for the allocation, and CP-1C's
+`peer_statistics.py` for each case's enterprise value.
+
+The SKILL names `recovery_waterfall.py` as the owner of "per-class recovery under each
+enterprise-value case and the fulcrum in each", and CP-4B's runbook says "CP-3A owns the dollar
+waterfall". No CP-3 register holds its inputs or results (T3B.2's Amount is carrying value, T3B.4
+an ordinal, T3B.6 a label; no register holds an enterprise value), so CP-3 is asked for one table
+(owner, 2026-11-15: "1. yes 2. yes 3. yes"):
+
+| Line | Amount | Low | Base | High | Currency | Scale |
+|---|---|---|---|---|---|---|
+| Enterprise value | — | <EV> | <EV> | <EV> | USD | m |
+| EV multiple | — | <x> | <x> | <x> | — | — |
+| EV metric | — | <EBITDA> | <EBITDA> | <EBITDA> | USD | m |
+| EV basis | — | <metric, period, multiple basis, source> | ... | ... | — | — |
+| Cost: <label> | <amount> | — | — | — | USD | m |
+| Claim: <instrument> | <claim> | <recovery %> | <recovery %> | <recovery %> | USD | m |
+| Fulcrum | — | <instrument or None> | ... | ... | — | — |
+| Residual to equity | — | <amount> | <amount> | <amount> | USD | m |
+
+Where CP-3 receives CP-1C, the cases are CP-1C's T4.10 Low, Median and High implied EV (this
+overrides CP-1C's own "NOT recovery estimate" rule for CP-3's use only); otherwise CP-3 states its
+own cases with their basis, or `Not supplied: <reason>` where none can be supported (recorded, not
+refused). Claims are allocated in row order, senior first, as the script takes them. A handoff
+without the table, unless CP-3 stopped at its gate, is sent back.
+"""
+
+import re
+import types
+from dataclasses import dataclass, replace
+from typing import Any
+
+from deploy_workflow import method_scripts as core
+from deploy_workflow import method_scripts_cp3_ev as cp3_ev
+from deploy_workflow.method_scripts import (
+    AMOUNT_STEP,
+    ARCHIVE,
+    Loaded,
+    Outcome,
+    Status,
+    Table,
+    Upstream,
+    _cell_half,
+    _Claim,
+    _columns,
+    _judged,
+    _label,
+    _NotChecked,
+    _plain,
+    _value,
+    _Where,
+    blank,
+    currency_of,
+    quotient_slack,
+    scale_of,
+    share,
+)
+
+RECOVERY = ARCHIVE + "skills/cp-4c-restructuring-fulcrum/scripts/recovery_waterfall.py"
+WATERFALL_HEADING = "Recovery waterfall"
+CASES = ("Low", "Base", "High")
+WATERFALL_COLUMNS = ("Line", "Amount", *CASES, "Currency", "Scale")
+EV, FULCRUM, RESIDUAL = "Enterprise value", "Fulcrum", "Residual to equity"
+# No debt claim is the fulcrum: value covers all of them, or none recovers in part.
+NO_FULCRUM = ("none", "no fulcrum", "n/a", "na", "not applicable", "equity", "nil")
+RECOVERY_FORMULA = (
+    "Recovery = min(claim, value left after the costs and every senior claim) / claim, value "
+    "allocated in the table's row order (recovery_waterfall.py)"
+)
+FULCRUM_FORMULA = (
+    "The fulcrum is the first claim, in row order, that recovers more than nothing and less than "
+    "in full; a boundary or zero recovery is no fulcrum (recovery_waterfall.py)"
+)
+RESIDUAL_FORMULA = (
+    "Residual to equity = enterprise value - costs - every claim's recovery, floored at 0; value "
+    "the claims do not absorb is not left unallocated (recovery_waterfall.py)"
+)
+MULTIPLE, METRIC, BASIS = "EV multiple", "EV metric", "EV basis"
+BASIS_ROWS = (MULTIPLE, METRIC, BASIS)
+_HEADING = f"`### {WATERFALL_HEADING}`"
+
+
+def _where(figure_name: str, script: str = RECOVERY) -> _Where:
+    return _Where("CP-3", script, figure_name, _HEADING)
+
+
+@dataclass(frozen=True)
+class _Waterfall:
+    """The table as the script reads it."""
+
+    claims: list[dict[str, Any]]  # in row order; a claim named twice is kept, for the script
+    stated: dict[str, list[str]]  # claim name -> its row, as written
+    costs: list[dict[str, Any]]
+    ev: dict[str, float | None]  # case -> enterprise value (None: stated none)
+    fulcrum: list[str] | None
+    residual: list[str] | None
+    unit: str
+    cols: dict[str, int]
+    halves: dict[str, float]  # `costs`, `claim:<name>`, `ev:<case>`: displayed rounding
+    basis: dict[str, list[str] | None]  # the EV multiple, metric and basis rows, as written
+    ev_cells: dict[str, str]  # case -> the Enterprise value cell, as written
+    skipped: tuple[str, ...]  # rows the check does not read (a total, a subtotal), named
+
+
+def _kind(line: str) -> tuple[str, str]:
+    """(`claim` | `cost` | the row's label, the name after `Claim:` / `Cost:`)."""
+    head, colon, rest = _plain(line).partition(":")
+    if colon and _label(head) in ("claim", "cost"):
+        return _label(head), rest.strip()
+    return _label(line), ""
+
+
+def _unit(rows: list[list[str]], cols: dict[str, int]) -> str:
+    """The table's one money unit; a row that states neither currency nor scale (`—`) takes it."""
+    stating = [r for r in rows if _plain(r[cols["Currency"]]) not in ("", *core.NOT_APPLICABLE)]
+    rows = stating or rows
+    pairs = {(currency_of(r[cols["Currency"]]), scale_of(r[cols["Scale"]])) for r in rows}
+    if len(pairs) != 1 or None in next(iter(pairs)):
+        shown = "; ".join(sorted({f"{r[cols['Currency']]} {r[cols['Scale']]}" for r in rows}))
+        raise _NotChecked(
+            f"{_HEADING} rows state different or unread currencies or scales: {shown}"
+        )
+    currency, scale = next(iter(pairs))
+    return f"{currency} {scale}"
+
+
+def _single(rows: dict[str, list[list[str]]], name: str) -> list[str] | None:
+    found = rows.get(_label(name), [])
+    if len(found) > 1:
+        raise _NotChecked(f"{_HEADING} has {len(found)} `{name}` rows")
+    return found[0] if found else None
+
+
+def _read(table: Table, tables: types.ModuleType) -> _Waterfall:
+    cols = _columns(table, WATERFALL_COLUMNS, _HEADING)
+    if isinstance(cols, str):
+        raise _NotChecked(cols)
+    claims, costs, money = [], [], []
+    halves: dict[str, float] = {"costs": 0.0}
+    stated: dict[str, list[str]] = {}
+    labelled: dict[str, list[list[str]]] = {}
+    skipped: list[str] = []
+    for row in table[1]:
+        kind, name = _kind(row[cols["Line"]])
+        if kind == "claim":
+            claims.append(
+                {"claim_id": name, "class": name, "amount": _value(row[cols["Amount"]], tables)}
+            )
+            stated[name] = row
+            halves[f"claim:{name}"] = _cell_half(row[cols["Amount"]], tables)
+        elif kind == "cost":
+            costs.append({"label": name, "amount": _value(row[cols["Amount"]], tables)})
+            halves["costs"] += _cell_half(row[cols["Amount"]], tables)
+        elif kind not in (_label(n) for n in (EV, FULCRUM, RESIDUAL, *BASIS_ROWS)):
+            if any("%" in row[cols[c]] for c in CASES):  # it may be a claim not marked `Claim:`
+                raise _NotChecked(
+                    f"{_HEADING} has a row the check does not read: `{row[cols['Line']]}`"
+                )
+            skipped.append(_plain(row[cols["Line"]]))
+            continue
+        else:
+            labelled.setdefault(kind, []).append(row)
+        if kind not in (_label(n) for n in (FULCRUM, MULTIPLE, BASIS)):
+            money.append(row)
+    ev_row = _single(labelled, EV)
+    if ev_row is None:
+        raise _NotChecked(f"{_HEADING} has no `{EV}` row")
+    ev = {case: _value(ev_row[cols[case]], tables) for case in CASES}
+    halves |= {f"ev:{case}": _cell_half(ev_row[cols[case]], tables) for case in CASES}
+    return _Waterfall(
+        claims,
+        stated,
+        costs,
+        ev,
+        _single(labelled, FULCRUM),
+        _single(labelled, RESIDUAL),
+        _unit(money, cols),
+        cols,
+        halves,
+        {name: _single(labelled, name) for name in BASIS_ROWS},
+        {case: ev_row[cols[case]] for case in CASES},
+        tuple(skipped),
+    )
+
+
+def _recoveries(
+    case: str, w: _Waterfall, result: dict[str, Any], tables: types.ModuleType
+) -> list[Outcome]:
+    out = []
+    above = w.halves[f"ev:{case}"] + w.halves["costs"]  # rounding of the value left for a claim
+    for row in result["claims"]:
+        name = row["claim_id"]
+        own = w.halves.get(f"claim:{name}", 0.0)
+        where = _where(f"Recovery: {name} ({case})")
+        cell = w.stated[name][w.cols[case]]
+        if blank(cell, tables):
+            out.append(
+                where(
+                    "not checked", stated=cell, reason=f"no recovery is stated for {name} in {case}"
+                )
+            )
+        elif row["recovery_pct"] is None:
+            why = result.get("note") or f"{name}'s claim is 0, so it has no recovery percentage"
+            out.append(where("not checked", stated=cell, reason=str(why)))
+        else:
+            slack = quotient_slack(row["recovered"], above, row["amount"], own)
+            claim = _Claim(where, cell, row["recovery_pct"], 0.0, "", RECOVERY_FORMULA)
+            out.append(share(replace(claim, slack=slack), tables))
+        above += own  # a junior claim's value is what is left after this one
+    return out
+
+
+def _named(cell: str) -> str:
+    """The claim a fulcrum cell names: a leading `Claim:` and a trailing note (after a dash, or
+    in brackets) are not the name (`Debt (66.7%)`, `Debt - 66.7% recovery` name `Debt`)."""
+    text = re.sub(r"^\s*claim\s*:\s*", "", _plain(cell), flags=re.IGNORECASE)
+    text = re.sub(r"\s*\([^)]*\)\s*$", "", text)
+    return _label(re.split(r"\s+[-—–]\s+", text, maxsplit=1)[0])
+
+
+def _fulcrum(case: str, w: _Waterfall, result: dict[str, Any]) -> Outcome:
+    where = _where(f"{FULCRUM} ({case})")
+    cell = None if w.fulcrum is None else w.fulcrum[w.cols[case]]
+    if cell is None or _plain(cell) in ("", *core.NOT_APPLICABLE):
+        return where("not checked", stated=cell, reason=f"{_HEADING} states no fulcrum for {case}")
+    if result["status"] != "complete":
+        return where("not checked", stated=cell, reason=str(result.get("note")))
+    found, name = result["fulcrum_claim_id"], _named(cell)
+    claims = {_named(c["claim_id"]) for c in w.claims}
+    if name not in NO_FULCRUM and name not in claims:
+        why = f"`{cell}` names no claim of the table and none of {', '.join(NO_FULCRUM)}"
+        return where("not checked", stated=cell, reason=why)
+    agreed = name in NO_FULCRUM if found is None else name == _named(found)
+    label = "no fulcrum" if found is None else str(found)
+    status: Status = "agreed" if agreed else "disagreed"
+    return where(status, stated=cell, recomputed_label=label, reason=FULCRUM_FORMULA)
+
+
+def _residual(
+    case: str, w: _Waterfall, result: dict[str, Any], tables: types.ModuleType
+) -> Outcome:
+    where = _where(f"{RESIDUAL} ({case})")
+    cell = None if w.residual is None else w.residual[w.cols[case]]
+    if cell is None or blank(cell, tables):
+        return where(
+            "not checked", stated=cell, reason=f"{_HEADING} states no {RESIDUAL} for {case}"
+        )
+    if result["residual_to_equity"] is None:
+        return where("not checked", stated=cell, reason=str(result.get("note")))
+    claim = _Claim(where, cell, result["residual_to_equity"], AMOUNT_STEP, w.unit, RESIDUAL_FORMULA)
+    claims = sum(h for k, h in w.halves.items() if k.startswith("claim:"))
+    slack = w.halves[f"ev:{case}"] + w.halves["costs"] + claims  # a difference of all of them
+    return _judged(replace(claim, slack=slack), tables)
+
+
+def _ev_case(case: str, w: _Waterfall) -> cp3_ev.Case:
+    def cell(name: str) -> str | None:
+        row = w.basis.get(name)
+        return None if row is None else row[w.cols[case]]
+
+    return cp3_ev.Case(case, w.ev_cells[case], cell(MULTIPLE), cell(METRIC), cell(BASIS), w.unit)
+
+
+def _case(case: str, w: _Waterfall, loaded: Loaded, upstream: Upstream) -> list[Outcome]:
+    result = None
+    if w.ev[case] is None:
+        reason = f"{_HEADING} states no {EV} for {case} (missing, not zero)"
+    else:
+        result = loaded.script.waterfall(w.ev[case], w.claims, w.costs)
+        reason = str(result.get("note"))  # a cost without an amount stops the whole case
+    values = cp3_ev.outcomes(_ev_case(case, w), loaded, upstream)
+    if result is None or "claims" not in result:
+        names = [f"Recovery: {c['claim_id']} ({case})" for c in w.claims]
+        names += [f"{FULCRUM} ({case})", f"{RESIDUAL} ({case})"]
+        return [*values, *(_where(n)("not checked", reason=reason) for n in names)]
+    return [
+        *values,
+        *_recoveries(case, w, result, loaded.tables),
+        _fulcrum(case, w, result),
+        _residual(case, w, result, loaded.tables),
+    ]
+
+
+MISSING_TABLE = (
+    f"Write `### {WATERFALL_HEADING}` in `## Findings` as your instructions describe. Where no "
+    f"enterprise value can be supported, write the table with each `{EV}` cell as `Not supplied: "
+    "<reason>`; that is recorded, not refused."
+)
+
+
+_TITLE = re.compile(r"^\s*(?:#{1,6}\s+(?P<heading>.*?)\s*#*|\*\*(?P<bold>.+?)\*\*\s*:?)\s*$")
+
+
+def find_table(text: str) -> Table | str | None:
+    """The waterfall table: under a heading (any level) or a bold line whose words include
+    "recovery waterfall" (numbering and a trailing note aside), else the one table with its
+    columns. None when there is none; why, when there are two or it is unread."""
+    lines = core._unfenced(text)
+    titles = []
+    for i, line in enumerate(lines):
+        found = _TITLE.match(line)
+        if found and "recovery waterfall" in _label(found["heading"] or found["bold"] or ""):
+            titles.append(i)
+    if len(titles) > 1:
+        return f"the handoff has {len(titles)} recovery waterfall headings"
+    if titles:
+        return core._table_after(lines, titles[0], _HEADING)
+    wanted = {_label(c) for c in WATERFALL_COLUMNS}
+    headers = [
+        i
+        for i, line in enumerate(lines)
+        if line.lstrip().startswith("|") and wanted <= {_label(c) for c in core._cells(line)}
+    ]
+    if len(headers) > 1:
+        return f"the handoff has {len(headers)} tables with the waterfall's columns"
+    return core._table_after(lines, headers[0] - 1, _HEADING) if headers else None
+
+
+def check(text: str, loaded: Loaded, upstream: Upstream) -> list[Outcome]:
+    """Each case's enterprise value (its basis, its arithmetic and its copy from CP-1C's T4.10),
+    then recovery by claim, the fulcrum and the residual to equity, recomputed by the scripts from
+    the table's own rows. An absent table is sent back unless CP-3 stopped at its gate."""
+    table = find_table(text)
+    if table is None:
+        if core.blocked(text):
+            return [_where(WATERFALL_HEADING)("not checked", reason="CP-3 stopped at its gate")]
+        return [_where(WATERFALL_HEADING)("missing", reason=MISSING_TABLE)]
+    try:
+        if isinstance(table, str):
+            raise _NotChecked(table)
+        waterfall = _read(table, loaded.tables)
+        skipped = [
+            _where(f"Row: {name}")("not checked", reason="a row the check does not read")
+            for name in waterfall.skipped
+        ]
+        return [*skipped, *(o for case in CASES for o in _case(case, waterfall, loaded, upstream))]
+    except _NotChecked as why:
+        return [_where(WATERFALL_HEADING)("not checked", reason=str(why))]
+    except ValueError as error:  # the script refuses: a claim named twice, a negative amount
+        cause = f"the script refused the table: {error}"
+        return [_where(WATERFALL_HEADING)("not checked", reason=cause)]
+
+
+CP3_NOTE = (
+    "Python checks your recovery waterfall after you answer, with the method's own "
+    "`recovery_waterfall.py` and CP-1C's `peer_statistics.py` (you cannot run them). Write it in "
+    f"`## Findings` as `### {WATERFALL_HEADING}` with the columns "
+    f"`{' | '.join(WATERFALL_COLUMNS)}`: an `{EV}` row; `{MULTIPLE}`, `{METRIC}` (the EBITDA or "
+    f"revenue it multiplies) and `{BASIS}` (that metric and its period, the multiple's basis and "
+    "where each came from) rows; a `Cost: <label>` row per cost; a `Claim: <instrument>` row per "
+    "claim, senior first, its claim in Amount and its recovery % in each case (claims that rank "
+    "equally share one row naming them all); `Fulcrum` (the claim, or None); `Residual to "
+    "equity`. Where you were sent CP-1C's T4.10, the cases are its Low, Median and High implied "
+    "EV, each basis beginning `CP-1C T4.10 EV/EBITDA` (or its method); "
+    "otherwise state your own cases with their basis from the evidence you were given. Where no "
+    f"enterprise value can be supported, write each `{EV}` cell `Not supplied: <reason>`: that is "
+    "recorded, not refused. An implied EV from peer multiples is indicative, not a valuation: "
+    "say in your limitations that the recoveries carry that limitation. A cell that does not "
+    "apply is `—`. A figure that disagrees is sent back for repair, and so is a missing table.\n\n"
+)
+# Owner, 2026-11-15: "1. yes 2. yes 3. yes" (ruling 2026-11-15-method-script-checks.md).
+core.register("CP-3", RECOVERY, check, CP3_NOTE)

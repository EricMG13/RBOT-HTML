-    if not isinstance(node.value, ast.Name):
-        return
-    holder = owner if node.value.id in ("self", "cls") else node.value.id
-    if holder in classes and f"{holder}.{node.attr}" in defs:
-        yield f"{holder}.{node.attr}"

+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Signal feed mockup</title>
+<style>
+:root{--navy:#000533;--blue:#001aff;--blue-50:#e5e8ff;--blue-100:#c2c9ff;--ground:#f4f4f5;--rule:#e8e9eb;--line:#d1d4d8;--muted:#474a4f;--quiet:#63676e;--card:#fff;--amber:#806300;--amber-bg:#fff4cc;--red:#8e413e;--red-bg:#fbeceb;--green:#0f8048;--green-bg:#e3f6ec;--violet:#514d80;--violet-bg:#eeedff;--shadow:0 1px 3px rgba(0,5,51,.1),0 1px 2px -1px rgba(0,5,51,.1)}
+*{box-sizing:border-box}
+body{margin:0;background:var(--ground);color:var(--navy);font:13px/1.45 "Red Hat Text",system-ui,-apple-system,"Segoe UI",sans-serif}
+h1,h2,h3,p{margin:0}
+button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
+.sample{background:var(--amber-bg);color:var(--amber);font-size:12px;padding:6px 16px;text-align:center}
+.app{display:grid;grid-template-columns:56px 228px minmax(0,1fr) 360px;height:calc(100vh - 30px);min-height:640px}
+/* rail */
+.rail{background:var(--navy);display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 0}
+.rail .mark{width:26px;height:26px;border-radius:6px;background:#fff;margin-bottom:10px}
+.rail a{width:38px;height:38px;border-radius:8px;display:grid;place-items:center;color:#aab0d6}
+.rail a.on{background:var(--blue);color:#fff}
+.rail svg,.ico{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
+/* channels */
+.side{background:#fff;border-right:1px solid var(--rule);padding:14px 10px;overflow:auto}
+.side h1{font:700 17px "Red Hat Display",system-ui,sans-serif;padding:0 8px 10px;display:flex;align-items:center;gap:8px}
+.side h2{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--quiet);padding:14px 8px 4px;display:flex;justify-content:space-between}
+.ch{display:flex;align-items:center;gap:8px;width:100%;padding:6px 8px;border-radius:8px;text-align:left}
+.ch:hover{background:var(--ground)}
+.ch.on{background:var(--blue-50);color:var(--blue);font-weight:600}
+.ch .n{margin-left:auto;font-size:12px;font-weight:600;background:var(--blue);color:#fff;border-radius:99px;padding:2px 8px}
+.ch .dot{width:7px;height:7px;border-radius:50%;background:var(--green);margin-left:auto}
+.hash{color:var(--quiet);width:14px;text-align:center}
+/* feed */
+.feed{overflow:auto;padding:16px 20px 40px}
+.bar{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap}
+.seg{display:inline-flex;background:#fff;border:1px solid var(--line);border-radius:8px;padding:2px}
+.seg button{padding:4px 12px;border-radius:6px;color:var(--muted)}
+.seg button.on{background:var(--navy);color:#fff}
+.chip{border:1px solid var(--line);background:#fff;border-radius:99px;padding:4px 12px;font-size:12px;color:var(--muted)}
+.chip.on{border-color:var(--blue);color:var(--blue);background:var(--blue-50)}
+.live{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:12px;color:var(--quiet)}
+.pulse{width:8px;height:8px;border-radius:50%;background:var(--green)}
+.card{background:var(--card);border:1px solid var(--rule);border-radius:12px;box-shadow:var(--shadow);padding:14px 16px;margin-bottom:12px;max-width:720px}
+.card.sel{border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,26,255,.14)}
+.meta{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--quiet);margin-bottom:6px}
+.src{width:20px;height:20px;border-radius:5px;display:grid;place-items:center;font:700 12px "Red Hat Mono",ui-monospace,monospace;color:#fff;background:var(--navy)}
+.src.reg{background:var(--violet)}.src.rat{background:var(--amber)}.src.dig{background:var(--blue)}
+.kind{font-size:12px;font-weight:600;border-radius:4px;padding:3px 8px}
+.kind.reg{background:var(--violet-bg);color:var(--violet)}.kind.rat{background:var(--amber-bg);color:var(--amber)}.kind.news{background:var(--ground);color:var(--muted)}
+.sig{margin-left:auto;display:inline-flex;align-items:flex-end;gap:2px;height:14px}
+.sig i{width:3px;background:var(--line);border-radius:1px}
+.sig i:nth-child(1){height:5px}.sig i:nth-child(2){height:9px}.sig i:nth-child(3){height:14px}
+.sig.s1 i:nth-child(-n+1),.sig.s2 i:nth-child(-n+2),.sig.s3 i{background:var(--blue)}
+.card h3{font:600 18px/1.3 "Red Hat Display",system-ui,sans-serif;margin-bottom:6px}
+.why{display:flex;gap:8px;background:var(--blue-50);border-radius:8px;padding:8px 10px;margin:8px 0;color:#0012b2}
+.why b{font:600 12px "Red Hat Mono",ui-monospace,monospace;background:#fff;border-radius:4px;padding:3px 8px;height:fit-content}
+.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
+.tag{font-size:12px;border:1px solid var(--rule);border-radius:4px;padding:3px 8px;color:var(--muted)}
+.acts{display:flex;gap:4px;border-top:1px solid var(--rule);margin:12px -16px -6px;padding:6px 10px 0}
+.acts button{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;color:var(--muted);font-size:12px}
+.acts button:hover{background:var(--ground)}
+.acts .open{margin-left:auto;color:var(--blue)}
+.shared{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:10px;padding-bottom:10px;border-bottom:1px dashed var(--rule)}
+.av{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:700;color:#fff;background:var(--blue);flex:none}
+.av.b{background:var(--green)}.av.c{background:var(--violet)}.av.d{background:var(--amber)}
+/* case stepper */
+.steps{display:grid;grid-template-columns:repeat(4,1fr);margin:10px 0 4px}
+.st{position:relative;font-size:12px;color:var(--quiet);padding-top:16px}
+.st:before{content:"";position:absolute;top:4px;left:0;right:0;height:2px;background:var(--line)}
+.st:after{content:"";position:absolute;top:0;left:0;width:10px;height:10px;border-radius:50%;background:#fff;border:2px solid var(--line)}
+.st.done:before,.st.done:after{background:var(--violet);border-color:var(--violet)}
+.st.now:after{border-color:var(--violet);box-shadow:0 0 0 4px var(--violet-bg)}
+.st.now{color:var(--navy);font-weight:600}
+/* rating */
+.move{display:flex;align-items:center;gap:10px;margin:8px 0}
+.rt{font:600 16px "Red Hat Mono",ui-monospace,monospace;border:1px solid var(--line);border-radius:6px;padding:4px 10px}
+.rt.dn{background:var(--red-bg);border-color:var(--red);color:var(--red)}
+/* digest */
+.digest{background:var(--navy);color:#fff;border:0}
+.digest .meta{color:#aab0d6}.digest ol{margin:8px 0 0;padding-left:18px}.digest li{margin:3px 0}
+.digest .acts{border-color:rgba(255,255,255,.15)}.digest .acts button{color:#c2c9ff}.digest .acts button:hover{background:rgba(255,255,255,.08)}
+/* thread */
+.thread{background:#fff;border-left:1px solid var(--rule);display:flex;flex-direction:column;min-height:0}
+.thead{padding:12px 16px;border-bottom:1px solid var(--rule);display:flex;align-items:center;gap:8px}
+.thead b{font:600 14px "Red Hat Display",system-ui,sans-serif}
+.thead span{color:var(--quiet);font-size:12px}
+.tbody{flex:1;overflow:auto;padding:14px 16px}
+.quote{border:1px solid var(--rule);border-radius:8px;padding:8px 10px;margin-bottom:14px;font-size:12px}
+.quote b{display:block;font-size:13px;margin:2px 0}
+.msg{display:grid;grid-template-columns:24px 1fr;gap:8px;position:relative;padding-bottom:14px}
+.msg:not(.last):before{content:"";position:absolute;left:11.5px;top:28px;bottom:2px;width:1px;background:var(--rule)}
+.msg .who{font-weight:600}.msg .who span{font-weight:400;color:var(--quiet);font-size:12px;margin-left:6px}
+.msg.r{margin-left:32px}
+.react{display:inline-flex;gap:4px;margin-top:5px}
+.react span{font-size:12px;border:1px solid var(--rule);border-radius:99px;padding:2px 8px;color:var(--muted)}
+.role{font-size:12px;font-weight:600;border-radius:4px;padding:2px 8px;background:var(--ground);color:var(--muted);margin-left:6px}
+.day{display:flex;align-items:center;gap:8px;color:var(--quiet);font-size:12px;margin:2px 0 12px}
+.day:before,.day:after{content:"";flex:1;height:1px;background:var(--rule)}
+.comp{border-top:1px solid var(--rule);padding:10px 16px}
+.box{border:1px solid var(--line);border-radius:10px;padding:8px 10px;display:flex;align-items:center;gap:8px;color:var(--quiet)}
+.box .send{margin-left:auto;background:var(--blue);color:#fff;border-radius:6px;padding:4px 12px;font-weight:600}
+.note{font-size:12px;color:var(--quiet);margin-top:6px}
+@media (max-width:1100px){.app{grid-template-columns:56px 200px minmax(0,1fr)}.thread{display:none}}
+/* v2: post box, settings */
+.post{display:flex;align-items:center;gap:10px;max-width:720px;background:#fff;border:1px solid var(--rule);border-radius:12px;padding:10px 12px;margin-bottom:14px;box-shadow:var(--shadow)}
+.post .in{flex:1;border:1px solid var(--line);border-radius:99px;padding:7px 14px;color:var(--quiet)}
+.btn{border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-weight:600;background:#fff}
+.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff}
+.side .foot{margin-top:18px;border-top:1px solid var(--rule);padding-top:8px}
+.settings{display:none;grid-column:3 / 5;overflow:auto;padding:20px 24px 60px}
+body.s .feed,body.s .thread{display:none}
+body.s .settings{display:block}
+.settings>header{display:flex;align-items:baseline;gap:12px;margin-bottom:4px}
+.settings>header h2{font:700 24px "Red Hat Display",system-ui,sans-serif}
+.settings>header p{color:var(--quiet)}
+.stabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin:14px 0 18px;position:sticky;top:-20px;background:var(--ground);padding-top:6px;z-index:1}
+.stabs a{padding:8px 12px;color:var(--muted);border-bottom:2px solid transparent;text-decoration:none;font-weight:600}
+.stabs a.on{color:var(--blue);border-color:var(--blue)}
+.sec{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;padding:20px 0;border-bottom:1px solid var(--rule);max-width:1040px}
+.sec>div:first-child h3{font:600 16px "Red Hat Display",system-ui,sans-serif;margin-bottom:4px}
+.sec>div:first-child p{color:var(--quiet);font-size:12px}
+.who{display:inline-block;margin-top:8px;font-size:12px;font-weight:600;border-radius:4px;padding:3px 8px;background:var(--blue-50);color:#0012b2}
+.who.own{background:var(--navy);color:#fff}.who.me{background:var(--green-bg);color:var(--green)}
+.panel{background:#fff;border:1px solid var(--rule);border-radius:12px;box-shadow:var(--shadow)}
+.panel+.panel{margin-top:12px}
+.row{display:flex;align-items:center;gap:10px;padding:10px 14px;border-top:1px solid var(--rule)}
+.row:first-child{border-top:0}
+.row .grow{flex:1;min-width:0}
+.row small{display:block;color:var(--quiet);font-size:12px}
+.stack{display:flex}.stack .av{margin-left:-6px;border:2px solid #fff;width:26px;height:26px}
+.pill{font-size:12px;border-radius:99px;padding:3px 10px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
+.pill.ok{border-color:var(--green);color:var(--green);background:var(--green-bg)}
+.pill.wait{border-color:var(--amber);color:var(--amber);background:var(--amber-bg)}
+.pill.off{background:var(--ground)}
+.tog{width:34px;height:20px;border-radius:99px;background:var(--line);position:relative;flex:none}
+.tog:after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:var(--shadow)}
+.tog.on{background:var(--blue)}.tog.on:after{left:16px}
+.form{padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
+.form label{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:4px}
+.form .f{border:1px solid var(--line);border-radius:8px;padding:7px 10px;min-height:34px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
+.form .f.ph{color:var(--quiet)}
+.form .wide{grid-column:1 / -1}
+.form .tpl{font:500 12px/1.6 "Red Hat Mono",ui-monospace,monospace;background:var(--quiet-bg,#fafafb);align-items:flex-start;display:block}
+.tpl mark{background:var(--blue-50);color:#0012b2;border-radius:4px;padding:0 4px}
+.ptitle{padding:10px 14px;font-weight:600;border-bottom:1px solid var(--rule);display:flex;align-items:center;gap:8px}
+.ptitle span{margin-left:auto;font-weight:400;color:var(--quiet);font-size:12px}
+.bars{display:inline-flex;align-items:flex-end;gap:2px;height:18px;width:54px}
+.bars i{flex:1;background:var(--blue-100);border-radius:1px}
+.meter{height:8px;border-radius:99px;background:var(--rule);overflow:hidden;margin:8px 0 4px}
+.meter i{display:block;height:100%;background:var(--blue);border-radius:99px}
+.grid3{display:grid;grid-template-columns:1fr 64px 64px;align-items:center}
+.grid3>*{padding:9px 14px;border-top:1px solid var(--rule)}
+.grid3>.h{border-top:0;font-size:12px;color:var(--quiet);font-weight:600}
+.grid3>.c{display:grid;place-items:center;padding:9px 0}
+.kw{display:flex;gap:6px;flex-wrap:wrap}
+</style>

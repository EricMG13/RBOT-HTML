diff --git a/.github/workflows/work-pc-pack.yml b/.github/workflows/work-pc-pack.yml
new file mode 100644
index 0000000..9fad185
--- /dev/null
+++ b/.github/workflows/work-pc-pack.yml
@@ -0,0 +1,48 @@
+name: work-pc pack
+
+# After every change to main, record what changed for the work PC (no git there):
+# tools/work_pc_delta.py writes the next numbered pack under docs/work-pc/syncs/,
+# starting where the previous pack ended, and commits it to main.
+on:
+  push:
+    branches: [main]
+    paths-ignore: ["docs/work-pc/**"]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: work-pc-pack
+  cancel-in-progress: false
+
+jobs:
+  pack:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main # the latest main, so a queued run sees the previous run's pack
+          fetch-depth: 0
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.13"
+      - name: write the pack
+        id: pack
+        run: |
+          message=$(python tools/work_pc_delta.py generate --head HEAD)
+          echo "$message"
+          echo "message=$message" >> "$GITHUB_OUTPUT"
+      - name: commit and push the pack
+        if: startsWith(steps.pack.outputs.message, 'wrote ')
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add docs/work-pc
+          git commit -m "docs(work-pc): change pack for $(git rev-parse --short HEAD)"
+          for attempt in 1 2 3; do
+            git push origin HEAD:main && exit 0
+            git pull --rebase origin main # a newer push gets its own pack in its own run
+          done
+          exit 1

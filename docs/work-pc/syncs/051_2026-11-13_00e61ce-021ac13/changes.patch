+    a.setAttribute('rel', 'noopener noreferrer');
+    if (label) a.setAttribute('aria-label', label);
+    return a;
+  }
+
+  function card(doc, story, now) {
+    const kind = Object.prototype.hasOwnProperty.call(KINDS, story.kind) ? story.kind : 'other';
+    const kindLabel = kind === 'other' ? String(story.kind || 'Story') : KINDS[kind];
+    const article = el(doc, 'article', 'card card-' + kind);
+    article.setAttribute('data-id', String(story.id));
+    article.setAttribute('tabindex', '-1');
+
+    article.appendChild(el(doc, 'span', 'kind', kindLabel));
+
+    const href = safeLink(story.link);
+    const h3 = el(doc, 'h3', 'headline');
+    if (href) h3.appendChild(externalLink(doc, href, 'headline-link', story.title));
+    else h3.textContent = story.title;
+    article.appendChild(h3);
+
+    const meta = el(doc, 'p', 'meta');
+    const mono = el(doc, 'span', 'src', monogram(story.source));
+    mono.setAttribute('aria-hidden', 'true');
+    meta.appendChild(mono);
+    meta.appendChild(el(doc, 'span', 'src-name', story.source));
+    // The frozen card probe expects a time element even when the time is unknown; it is then empty and hidden.
+    const when = el(doc, 'time', 'when', relativeTime(story.published_at, now));
+    if (parseTime(story.published_at)) {
+      when.setAttribute('datetime', String(story.published_at));
+      when.setAttribute('title', fullTime(story.published_at));
+    } else {
+      when.setAttribute('hidden', '');
+    }
+    meta.appendChild(when);
+    article.appendChild(meta);
+
+    if (story.summary) article.appendChild(el(doc, 'p', 'summary', story.summary));
+
+    if (story.topics && story.topics.length) {
+      const tags = el(doc, 'ul', 'tags');
+      for (const name of story.topics) tags.appendChild(el(doc, 'li', 'tag', name));
+      article.appendChild(tags);
+    }
+    if (story.other_sources > 0) {
+      const also = el(doc, 'p', 'also');
+      also.appendChild(icon(doc, 'layers'));
+      also.appendChild(el(doc, 'span', null,
+        'Also in ' + story.other_sources + ' other ' + (story.other_sources === 1 ? 'source' : 'sources')));
+      article.appendChild(also);
+    }
+
+    const acts = el(doc, 'div', 'acts');
+    const save = el(doc, 'button', 'act save');
+    save.setAttribute('type', 'button');
+    save.setAttribute('data-action', 'save');
+    save.setAttribute('aria-pressed', story.saved ? 'true' : 'false');
+    save.setAttribute('aria-label', 'Save: ' + story.title);
+    save.appendChild(icon(doc, 'bookmark'));
+    save.appendChild(el(doc, 'span', null, 'Save'));
+    acts.appendChild(save);
+    if (href) {
+      const open = externalLink(doc, href, 'act open', null, 'Open source: ' + story.title + ' (opens in a new tab)');
+      open.appendChild(el(doc, 'span', null, 'Open source'));
+      open.appendChild(icon(doc, 'external'));
+      acts.appendChild(open);
+    }
+    article.appendChild(acts);
+    return article;
+  }
+
+  // opts: {approved: number | undefined, kind: string} refine the Latest and filtered messages.
+  function emptyState(doc, view, query, opts) {
+    const o = opts || {};
+    const box = el(doc, 'div', 'empty');
+    let title;
+    let hint = '';
+    if (query) {
+      title = 'No story matches ' + query;
+      hint = 'Check the spelling or clear the search.';
+    } else if (o.kind) {
+      title = 'No stories of this kind here';
+      hint = 'Choose All to see every kind.';
+    } else if (view === 'foryou') {
+      title = 'Follow a topic to fill this view';
+      hint = 'Stories on the topics you follow appear here.';
+    } else if (view === 'saved') {
+      title = 'Stories you save appear here';
+      hint = 'Use Save on a story to keep it.';
+    } else if (view === 'latest') {
+      title = o.approved === 0 ? 'No approved sources yet' : 'No stories yet';
+      hint = o.approved === 0
+        ? 'Stories appear once a source is approved.' : 'New stories appear here as sources are checked.';
+    } else {
+      title = 'No stories in this topic yet';
+    }
+    box.appendChild(el(doc, 'h2', 'empty-title', title));
+    if (hint) box.appendChild(el(doc, 'p', 'empty-hint', hint));
+    if (view === 'foryou' && !query && !o.kind) {
+      const slot = el(doc, 'div', 'empty-topics');
+      slot.setAttribute('data-slot', 'topics');
+      box.appendChild(slot);
+    }
+    return box;
+  }
+
+  return {card, emptyState, relativeTime, safeLink, icon, fullTime, initials};
+});
diff --git a/src/deploy_workflow/signal/web/render.test.cjs b/src/deploy_workflow/signal/web/render.test.cjs
new file mode 100644
index 0000000..f6fa36c
--- /dev/null
+++ b/src/deploy_workflow/signal/web/render.test.cjs
@@ -0,0 +1,126 @@
+'use strict';
+// Card rendering of the Signal feed page, tested with a small DOM double (no browser).
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { card, relativeTime, safeLink, emptyState, initials } = require('./render.js');
+
+// A DOM double. textContent is plain text and never parsed as markup, like the real DOM.
+class Text {
+  constructor(data) { this.data = data; this.parent = null; }
+  get textContent() { return this.data; }
+}
+class El {
+  constructor(tag) { this.tagName = tag.toUpperCase(); this.children = []; this.attrs = {}; this.parent = null; this.hidden = false; }
+  get className() { return this.attrs.class || ''; }
+  set className(v) { this.attrs.class = String(v); }
+  get textContent() { return this.children.map(c => c.textContent).join(''); }
+  set textContent(v) { this.children = []; if (String(v) !== '') this.appendChild(new Text(String(v))); }
+  setAttribute(k, v) { this.attrs[k] = String(v); }
+  getAttribute(k) { return k in this.attrs ? this.attrs[k] : null; }
+  hasAttribute(k) { return k in this.attrs; }
+  appendChild(c) { c.parent = this; this.children.push(c); return c; }
+  append(...cs) { for (const c of cs) this.appendChild(typeof c === 'string' ? new Text(c) : c); }
+  elements() { const out = []; for (const c of this.children) if (c instanceof El) out.push(c, ...c.elements()); return out; }
+  querySelectorAll(sel) {
+    const tests = sel.split(',').map(s => matcher(s.trim()));
+    return this.elements().filter(e => tests.some(t => t(e)));
+  }
+  querySelector(sel) { return this.querySelectorAll(sel)[0] || null; }
+}
+// Supports: tag, .class, [attr], [attr="value"] and their combinations (no combinators).
+function matcher(sel) {
+  const re = /^([a-z0-9]*)((?:\.[\w-]+|\[[\w-]+(?:="[^"]*")?\])*)$/i;
+  const m = re.exec(sel);
+  if (!m) throw new Error('unsupported selector ' + sel);
+  const parts = m[2].match(/\.[\w-]+|\[[\w-]+(?:="[^"]*")?\]/g) || [];
+  return e => {
+    if (m[1] && e.tagName !== m[1].toUpperCase()) return false;
+    return parts.every(p => {
+      if (p[0] === '.') return e.className.split(/\s+/).includes(p.slice(1));
+      const [, k, v] = /^\[([\w-]+)(?:="([^"]*)")?\]$/.exec(p);
+      return v === undefined ? e.hasAttribute(k) : e.getAttribute(k) === v;
+    });
+  };
+}
+const doc = { createElement: tag => new El(tag), createElementNS: (ns, tag) => new El(tag), createTextNode: s => new Text(s) };
+
+test('the DOM double does not parse markup', () => {
+  const e = doc.createElement('div'); e.textContent = '<b>x</b>';
+  assert.equal(e.querySelectorAll('b').length, 0);
+  assert.equal(e.textContent, '<b>x</b>');
+});
+
+test('relativeTime', () => {
+  const now = new Date('2026-11-13T12:00:00Z');
+  assert.equal(relativeTime('2026-11-13T11:59:40Z', now), 'just now');
+  assert.equal(relativeTime('2026-11-13T11:15:00Z', now), '45 min ago');
+  assert.equal(relativeTime('2026-11-13T03:00:00Z', now), '9 h ago');
+  assert.equal(relativeTime('2026-11-10T12:00:00Z', now), '3 d ago');
+  assert.equal(relativeTime('2026-11-01T12:00:00Z', now), '1 Nov 2026');
+  assert.equal(relativeTime('2026-11-14T12:00:00Z', now), 'just now');
+});
+test('safeLink allows only http and https', () => {
+  assert.equal(safeLink('https://a.org/x'), 'https://a.org/x');
+  for (const bad of ['javascript:alert(1)', 'data:text/html,x', ' JAVASCRIPT:alert(1)', 'file:///etc/passwd', '//a.org/x', ''])
+    assert.equal(safeLink(bad), null);
+});
+test('a card renders hostile text as text', () => {
+  const el = card(doc, {id: 1, title: '<img src=x onerror=alert(1)>', summary: '</script><b>x</b>', link: 'javascript:alert(1)',
+                        source: '<i>S</i>', kind: 'news', published_at: '2026-11-13T11:00:00Z', other_sources: 2, saved: false,
+                        topics: ['<u>T</u>']}, new Date('2026-11-13T12:00:00Z'));
+  assert.equal(el.querySelectorAll('img, b, i, u, script').length, 0);
+  assert.ok(el.textContent.includes('<img src=x onerror=alert(1)>'));
+  assert.equal(el.querySelector('a[href]'), null);                 // no link for a javascript: URL
+  assert.ok(el.textContent.includes('Also in 2 other sources'));
+});
+test('a card links out safely and marks its kind in words', () => {
+  const el = card(doc, {id: 2, title: 'T', summary: '', link: 'https://a.org/x', source: 'Authority', kind: 'regulator',
+                        published_at: '2026-11-13T11:00:00Z', other_sources: 0, saved: true, topics: []}, new Date('2026-11-13T12:00:00Z'));
+  const a = el.querySelector('a[href]');
+  assert.equal(a.getAttribute('rel'), 'noopener noreferrer'); assert.equal(a.getAttribute('target'), '_blank');
+  assert.ok(el.textContent.includes('Regulator'));
+  assert.equal(el.querySelector('[data-action="save"]').getAttribute('aria-pressed'), 'true');
+  assert.ok(!el.textContent.includes('other sources'));
+});
+
+test('a single other source uses the singular', () => {
+  const el = card(doc, {id: 3, title: 'T', summary: 's', link: 'https://a.org/x', source: 'Wire', kind: 'ratings',
+                        published_at: '2026-11-13T11:00:00Z', other_sources: 1, saved: false, topics: []}, new Date('2026-11-13T12:00:00Z'));
+  assert.ok(el.textContent.includes('Also in 1 other source'));
+  assert.ok(!el.textContent.includes('1 other sources'));
+  assert.ok(el.textContent.includes('Ratings'));
+  assert.equal(el.querySelector('[data-action="save"]').getAttribute('aria-pressed'), 'false');
+});
+
+test('empty states say what to do, with the query as text', () => {
+  assert.ok(emptyState(doc, 'foryou', '').textContent.includes('Follow a topic to fill this view'));
+  assert.ok(emptyState(doc, 'saved', '').textContent.includes('Stories you save appear here'));
+  assert.ok(emptyState(doc, 'latest', '', {approved: 0}).textContent.includes('No approved sources yet'));
+  const s = emptyState(doc, 'latest', '<b>x</b>');
+  assert.ok(s.textContent.includes('No story matches <b>x</b>'));
+  assert.equal(s.querySelectorAll('b').length, 0);
+});
+
+test('an unknown approved count does not claim there are no approved sources', () => {
+  const unknown = emptyState(doc, 'latest', '', {approved: undefined}).textContent;
+  assert.ok(unknown.includes('No stories yet'));
+  assert.ok(!unknown.includes('approved sources'));
+  assert.ok(emptyState(doc, 'latest', '', {approved: 0}).textContent.includes('No approved sources yet'));
+  assert.ok(emptyState(doc, 'latest', '', {approved: 3}).textContent.includes('No stories yet'));
+});
+test('a missing or unparseable time is empty and renders an empty hidden time element', () => {
+  const now = new Date('2026-11-13T12:00:00Z');
+  for (const bad of [null, undefined, '', 'not a time']) assert.equal(relativeTime(bad, now), '');
+  const el = card(doc, {id: 1, title: 'T', kind: 'news', published_at: null}, now);
+  const time = el.querySelector('time');
+  assert.equal(time.textContent, '');
+  assert.ok(time.hasAttribute('hidden'));
+  assert.ok(!time.hasAttribute('datetime'));
+});
+test('initials are letters or digits of the first two words', () => {
+  assert.equal(initials('A. Kovac'), 'AK');
+  assert.equal(initials('eve'), 'E');
+  assert.equal(initials('  '), '?');
+  assert.equal(initials('Ünal Çelik'), 'ÜÇ');
+  assert.equal(initials('<b>x</b> y'), 'Y');
+});
diff --git a/src/deploy_workflow/signal/web/signal.css b/src/deploy_workflow/signal/web/signal.css
index 8104aff..2c3edd0 100644
--- a/src/deploy_workflow/signal/web/signal.css
+++ b/src/deploy_workflow/signal/web/signal.css
@@ -1 +1,188 @@
-/* The feed page styles land in the next task. */
+@font-face{font-family:"Red Hat Display";src:url(/static/fonts/RedHatDisplay-SemiBold.woff2) format("woff2");font-weight:600;font-display:swap}
+@font-face{font-family:"Red Hat Display";src:url(/static/fonts/RedHatDisplay-Bold.woff2) format("woff2");font-weight:700;font-display:swap}
+@font-face{font-family:"Red Hat Text";src:url(/static/fonts/RedHatText-Regular.woff2) format("woff2");font-weight:400;font-display:swap}
+@font-face{font-family:"Red Hat Text";src:url(/static/fonts/RedHatText-Medium.woff2) format("woff2");font-weight:500;font-display:swap}
+@font-face{font-family:"Red Hat Text";src:url(/static/fonts/RedHatText-SemiBold.woff2) format("woff2");font-weight:600;font-display:swap}
+@font-face{font-family:"Red Hat Mono";src:url(/static/fonts/RedHatMono-Medium.woff2) format("woff2");font-weight:500;font-display:swap}
+@font-face{font-family:"Red Hat Mono";src:url(/static/fonts/RedHatMono-SemiBold.woff2) format("woff2");font-weight:600;font-display:swap}
+
+:root{
+  --navy:#000533;--blue:#001aff;--blue-50:#e5e8ff;--blue-ink:#0012b2;
+  --ground:#f4f4f5;--rule:#e8e9eb;--line:#d1d4d8;--muted:#474a4f;--quiet:#5a5e65;--card:#fff;
+  --amber:#806300;--amber-bg:#fff4cc;--red:#8e413e;--red-bg:#fbeceb;
+  --green:#0b6b3a;--green-bg:#e3f6ec;--violet:#514d80;--violet-bg:#eeedff;
+  --on-navy-quiet:#d9dcf8;
+  --shadow:0 1px 3px rgba(0,5,51,.1),0 1px 2px -1px rgba(0,5,51,.1);
+  --depth:0 8px 28px rgba(0,5,51,.085);
+  --fs-label:12px;--fs-body:13px;--fs-control:14px;
+  --display:"Red Hat Display",system-ui,-apple-system,"Segoe UI",sans-serif;
+  --text:"Red Hat Text",system-ui,-apple-system,"Segoe UI",sans-serif;
+  --mono:"Red Hat Mono",ui-monospace,monospace;
+}
+*{box-sizing:border-box}
+[hidden]{display:none!important}
+html{-webkit-text-size-adjust:100%}
+body{margin:0;background:var(--ground);color:var(--navy);font:400 var(--fs-body)/1.5 var(--text);overflow-x:hidden}
+h1,h2,h3,p,ul{margin:0;padding:0}
+ul{list-style:none}
+button,input{font:inherit;color:inherit}
+button{background:none;border:0;cursor:pointer}
+:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
+.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
+.ico{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
+.skip-link{position:absolute;left:8px;top:-60px;z-index:30;background:var(--navy);color:#fff;padding:8px 14px;border-radius:8px;font-weight:600;text-decoration:none}
+.skip-link:focus{top:8px;outline:2px solid #fff}
+
+.app{display:grid;grid-template-columns:56px 236px minmax(0,1fr);min-height:100vh}
+
+/* rail */
+.rail{position:sticky;top:0;height:100vh;background:var(--navy);display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 0}
+.brand-mark{display:block;width:30px;height:30px;margin-bottom:10px;background-size:26px 26px;background-repeat:no-repeat;background-position:center}
+.rail-list{display:flex;flex-direction:column;gap:6px;align-items:center}
+.rail-link{width:38px;height:38px;border-radius:8px;display:grid;place-items:center;color:var(--on-navy-quiet);text-decoration:none}
+.rail-link:hover{background:rgba(255,255,255,.1)}
+.rail-link.on{background:var(--blue);color:#fff}
+.rail :focus-visible{outline-color:#fff}
+
+/* channels */
+.side{position:sticky;top:0;height:100vh;overflow:auto;background:#fff;border-right:1px solid var(--rule);padding:14px 10px;display:flex;flex-direction:column}
+.brand{font:700 18px var(--display);display:flex;align-items:center;gap:8px;padding:0 8px 12px}
+.side-head{font:600 var(--fs-label)/1.4 var(--text);letter-spacing:.06em;text-transform:uppercase;color:var(--quiet);padding:16px 8px 4px}
+.ch-list{display:flex;flex-direction:column;gap:2px}
+.ch{display:flex;align-items:center;gap:8px;width:100%;padding:7px 8px;border-radius:8px;text-align:left;color:var(--navy);min-width:0}
+.ch:hover{background:var(--ground)}
+.ch[aria-current="page"]{background:var(--blue-50);color:var(--blue-ink);font-weight:600}
+.ch .ico{color:var(--quiet)}
+.ch[aria-current="page"] .ico{color:var(--blue-ink)}
+.ch-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
+.count{font-size:var(--fs-label);font-weight:600;background:var(--ground);color:var(--muted);border-radius:99px;padding:1px 8px;flex:none}
+.topic-row{display:flex;align-items:center;gap:2px}
+.topic-row .ch{flex:1}
+.follow{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;color:var(--quiet);flex:none}
+.follow:hover{background:var(--ground)}
+.follow[aria-pressed="true"]{color:var(--blue-ink)}
+.follow[aria-pressed="true"] .ico{fill:currentColor}
+.side-empty{padding:6px 8px;color:var(--quiet);font-size:var(--fs-label)}
+
+.me{position:relative;margin-top:auto;padding-top:12px;border-top:1px solid var(--rule)}
+.me-chip{display:flex;align-items:center;gap:8px;width:100%;padding:6px 8px;border-radius:8px;text-align:left}
+.me-chip:hover{background:var(--ground)}
+.av{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:var(--fs-label);font-weight:600;color:#fff;background:var(--blue);flex:none}
+.me-text{display:flex;flex-direction:column;min-width:0}
+.me-name{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.role{align-self:flex-start;font-size:var(--fs-label);font-weight:600;border-radius:4px;padding:0 6px;background:var(--ground);color:var(--muted)}
+.me-note{display:none;position:absolute;left:8px;right:8px;bottom:calc(100% - 4px);background:var(--navy);color:#fff;border-radius:8px;padding:8px 10px;font-size:var(--fs-label);box-shadow:var(--depth);z-index:5}
+.me:hover .me-note,.me:focus-within .me-note{display:block}
+
+/* feed */
+.main{min-width:0;padding:16px 20px 48px;display:grid;grid-template-columns:minmax(0,760px);justify-content:center;align-content:start}
+.main:focus{outline:0}
+.top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
+.top h2{font:700 22px/1.2 var(--display);overflow-wrap:anywhere}
+.live{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:var(--fs-label);color:var(--quiet)}
+.live.warn{color:var(--amber)}
+.pulse{width:8px;height:8px;border-radius:50%;background:var(--green);animation:pulse 2.4s ease-in-out infinite}
+.live.warn .pulse{background:var(--amber);animation:none}
+@keyframes pulse{50%{opacity:.35}}
+.btn.channels-toggle{display:none}
+.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-weight:600;background:#fff;color:var(--navy)}
+.btn:hover{background:var(--ground)}
+.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff}
+.btn.pri:hover{background:#0012cc}
+.btn:disabled{color:var(--quiet);cursor:default}
+
+.bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
+.chips{display:flex;gap:6px;flex-wrap:wrap}
+.chip{border:1px solid var(--line);background:#fff;border-radius:99px;padding:4px 12px;font-size:var(--fs-label);font-weight:500;color:var(--muted)}
+.chip:hover{background:var(--ground)}
+.chip[aria-pressed="true"]{border-color:var(--blue);color:var(--blue-ink);background:var(--blue-50);font-weight:600}
+.search{display:flex;align-items:center;gap:6px;flex:1;min-width:160px;max-width:300px;margin-left:auto;background:#fff;border:1px solid var(--line);border-radius:99px;padding:0 10px;color:var(--quiet)}
+.search:focus-within{outline:2px solid var(--blue);outline-offset:2px}
+.search input{flex:1;min-width:0;border:0;background:none;padding:6px 0;color:var(--navy);font-size:var(--fs-body)}
+.search input:focus,.search input:focus-visible{outline:0}
+.search input::placeholder{color:var(--quiet);opacity:1}
+kbd{font:500 var(--fs-label) var(--mono);border:1px solid var(--line);border-radius:4px;padding:0 6px;color:var(--quiet)}
+
+.pill-new{position:sticky;top:8px;z-index:4;display:block;margin:0 0 12px;background:var(--blue);color:#fff;font-weight:600;border-radius:99px;padding:6px 16px;box-shadow:var(--depth)}
+.pill-new:hover{background:#0012cc}
+.pill-new:focus-visible{outline-color:var(--navy)}
+
+.band{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px;background:var(--red-bg);border:1px solid var(--red);color:var(--red);border-radius:10px;padding:10px 14px}
+.band p{flex:1;min-width:0;overflow-wrap:anywhere;font-weight:600}
+
+/* cards */
+.cards{display:flex;flex-direction:column;gap:12px}
+.card{position:relative;background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--accent,var(--muted));border-radius:12px;box-shadow:var(--shadow);padding:12px 16px 6px;min-width:0}
+.card:focus{outline:0}
+.card:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
+.card-regulator{--accent:var(--violet)}
+.card-ratings{--accent:var(--amber)}
+.card-research{--accent:var(--green)}
+.card-news{--accent:var(--muted)}
+.card-other{--accent:var(--quiet)}
+.kind{display:inline-block;font-size:var(--fs-label);font-weight:600;letter-spacing:.04em;text-transform:uppercase;border-radius:4px;padding:1px 8px;margin-bottom:6px;background:var(--ground);color:var(--muted)}
+.card-regulator .kind{background:var(--violet-bg);color:var(--violet)}
+.card-ratings .kind{background:var(--amber-bg);color:var(--amber)}
+.card-research .kind{background:var(--green-bg);color:var(--green)}
+.headline{font:600 18px/1.3 var(--display);overflow-wrap:anywhere;margin-bottom:4px}
+.headline-link{color:var(--navy);text-decoration:none}
+.headline-link:hover{color:var(--blue-ink);text-decoration:underline}
+.meta{display:flex;align-items:center;gap:8px;font-size:var(--fs-label);color:var(--quiet);margin-bottom:6px;flex-wrap:wrap}
+.src{width:20px;height:20px;border-radius:5px;display:grid;place-items:center;font:600 12px var(--mono);color:#fff;background:var(--navy);flex:none}
+.card-regulator .src{background:var(--violet)}
+.card-ratings .src{background:var(--amber)}
+.card-research .src{background:var(--green)}
+.src-name{font-weight:600;color:var(--muted);overflow-wrap:anywhere}
+.when{white-space:nowrap}
+.when:before{content:"\00b7";margin-right:8px}
+.summary{color:var(--muted);overflow-wrap:anywhere;margin-bottom:6px}
+.tags{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
+.tag{font-size:var(--fs-label);border:1px solid var(--rule);border-radius:4px;padding:1px 8px;color:var(--muted);overflow-wrap:anywhere}
+.also{display:flex;align-items:center;gap:6px;font-size:var(--fs-label);color:var(--muted);margin:6px 0}
+.also .ico{width:14px;height:14px}
+.acts{display:flex;align-items:center;gap:4px;border-top:1px solid var(--rule);margin:8px -16px 0;padding:4px 10px}
+.act{display:inline-flex;align-items:center;gap:6px;padding:6px 8px;border-radius:6px;color:var(--muted);font-size:var(--fs-label);font-weight:600;text-decoration:none}
+.act:hover{background:var(--ground)}
+.act.open{margin-left:auto;color:var(--blue-ink)}
+.act .ico{width:16px;height:16px}
+.act.save[aria-pressed="true"]{color:var(--blue-ink)}
+.act.save[aria-pressed="true"] .ico{fill:currentColor}
+
+.skel{padding:16px;border-left-color:var(--line)}
+.bar-s{display:block;height:12px;border-radius:6px;margin-bottom:10px;background:linear-gradient(90deg,var(--rule) 25%,#f4f4f5 50%,var(--rule) 75%);background-size:200% 100%;animation:shimmer 1.4s linear infinite}
+.bar-s.w1{width:18%}.bar-s.w2{width:80%;height:16px}.bar-s.w3{width:30%}.bar-s.w4{width:65%}
+@keyframes shimmer{to{background-position:-200% 0}}
+
+.empty{background:#fff;border:1px dashed var(--line);border-radius:12px;padding:28px 24px;text-align:center}
+.empty-title{font:700 18px/1.3 var(--display);overflow-wrap:anywhere}
+.empty-hint{color:var(--muted);margin-top:4px}
+.empty-topics{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:14px}
+.empty-topics .chip{display:inline-flex;align-items:center;gap:6px}
+.empty-topics .ico{width:14px;height:14px}
+.more{display:block;justify-self:start;margin:14px 0 0}
+
+/* name dialog */
+dialog{border:0;border-radius:14px;padding:0;box-shadow:var(--depth);width:min(420px,calc(100vw - 32px));color:var(--navy)}
+dialog::backdrop{background:rgba(0,5,51,.55)}
+dialog form{padding:22px}
+dialog h2{font:700 20px var(--display);margin-bottom:6px}
+dialog p{color:var(--muted);margin-bottom:14px}
+dialog label{display:block;font-size:var(--fs-label);font-weight:600;color:var(--muted);margin-bottom:4px}
+dialog input{width:100%;border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:var(--fs-control)}
+.field-error{color:var(--red);font-weight:600;margin:8px 0 0}
+.dialog-acts{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
+
+@media (max-width:760px){
+  .app{grid-template-columns:48px minmax(0,1fr)}
+  .rail{width:48px}
+  .side{display:none;position:fixed;left:48px;top:0;bottom:0;z-index:20;width:min(270px,calc(100vw - 48px));box-shadow:var(--depth)}
+  .side.open{display:flex}
+  .btn.channels-toggle{display:inline-flex}
+  .main{padding:12px 12px 40px}
+  .live{margin-left:0;flex-basis:100%}
+  .search{max-width:none;flex-basis:100%;margin-left:0}
+  .acts{flex-wrap:wrap}
+}
+@media (prefers-reduced-motion:reduce){
+  *,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
+}
diff --git a/src/deploy_workflow/signal/web/signal.js b/src/deploy_workflow/signal/web/signal.js
index e81aae0..7d3018c 100644
--- a/src/deploy_workflow/signal/web/signal.js
+++ b/src/deploy_workflow/signal/web/signal.js
@@ -1 +1,458 @@
-// The feed page script lands in the next task.
+'use strict';
+// The Signal feed page: state, API calls and event wiring. Card markup comes from render.js; this file
+// builds no HTML from data (text goes in with textContent only).
+(function () {
+  const R = window.SignalRender;
+  const POLL_MS = 45000;
+  const SEARCH_DEBOUNCE_MS = 300;
+  const VIEW_TITLES = {foryou: 'For you', latest: 'Latest', saved: 'Saved'};
+
+  const $ = id => document.getElementById(id);
+  const els = {
+    channels: $('channels'), channelsToggle: $('channels-toggle'), viewList: $('view-list'), topicList: $('topic-list'),
+    title: $('view-title'), feed: $('feed'), cards: $('cards'), skeleton: $('skeleton'), empty: $('empty'), more: $('more'),
+    band: $('error-band'), bandText: $('error-text'), retry: $('retry'), pill: $('new-pill'), live: $('live'),
+    freshness: $('freshness'), freshnessText: $('freshness-text'), search: $('search'), kindChips: $('kind-chips'),
+    chip: $('name-chip'), meName: $('me-name'), meRole: $('me-role'), meInitials: $('me-initials'),
+    dialog: $('name-dialog'), form: $('name-form'), input: $('name-input'), nameError: $('name-error'), cancel: $('name-cancel'),
+  };
+
+  const state = {
+    view: 'foryou', kind: '', q: '', next: null, shown: 0, topics: [], approved: undefined,
+    me: null, seq: 0, loading: false, newest: null, retry: null, pollTimer: null, searchTimer: null,
+  };
+
+  class ApiError extends Error {
+    constructor(status, message) { super(message); this.status = status; }
+  }
+
+  async function api(method, path, body) {
+    const init = {method, headers: {}};
+    if (method !== 'GET') {
+      init.headers['Content-Type'] = 'application/json';
+      init.body = JSON.stringify(body === undefined ? {} : body);
+    }
+    let res;
+    try {
+      res = await fetch(path, init);
+    } catch (err) {
+      throw new ApiError(0, 'Signal could not be reached. Check your connection and try again.');
+    }
+    let data = null;
+    let readable = true;
+    try {
+      data = await res.json();
+    } catch (err) {
+      readable = false; // a body that is not JSON is reported below, by status or as unreadable
+    }
+    if (!res.ok) {
+      const message = data && typeof data.error === 'string' ? data.error : 'Signal could not complete that request.';
+      throw new ApiError(res.status, message);
+    }
+    if (!readable) throw new ApiError(res.status, 'The service sent an unreadable answer.');
+    return data;
+  }
+
+  function announce(text) {
+    els.live.textContent = '';
+    window.setTimeout(() => { els.live.textContent = text; }, 50);
+  }
+
+  function showError(message, retry) {
+    els.bandText.textContent = message;
+    els.band.hidden = false;
+    state.retry = retry;
+    announce(message);
+  }
+
+  function clearError() {
+    els.band.hidden = true;
+    state.retry = null;
+  }
+
+  function feedParams(before) {
+    const p = new URLSearchParams({view: state.view});
+    if (state.kind) p.set('kind', state.kind);
+    if (state.q) p.set('q', state.q);
+    if (before) p.set('before', before);
+    return p;
+  }
+
+  function setBusy(busy) {
+    state.loading = busy;
+    els.feed.setAttribute('aria-busy', busy ? 'true' : 'false');
+  }
+
+  function renderEmpty() {
+    els.empty.textContent = '';
+    if (state.shown > 0) { els.empty.hidden = true; return; }
+    els.empty.appendChild(R.emptyState(document, state.view, state.q, {approved: state.approved, kind: state.kind}));
+    renderTopicChoices();
+    els.empty.hidden = false;
+  }
+
+  // The topic list inside the For you empty state: the same follow action as the channel list star.
+  function renderTopicChoices() {
+    const slot = els.empty.querySelector('[data-slot="topics"]');
+    if (!slot) return;
+    for (const topic of state.topics) {
+      const b = document.createElement('button');
+      b.type = 'button';
+      b.className = 'chip';
+      b.setAttribute('data-follow', topic.id);
+      b.setAttribute('aria-pressed', topic.following ? 'true' : 'false');
+      b.textContent = topic.name;
+      slot.appendChild(b);
+    }
+  }
+
+  function appendCards(list) {
+    const now = new Date();
+    for (const story of list) els.cards.appendChild(R.card(document, story, now));
+    state.shown += list.length;
+  }
+
+  // Loads the current view. reset: replace the list (skeletons while waiting); otherwise append the
+  // next page. On failure the last good list stays and the error band offers Retry.
+  async function load(reset) {
+    const seq = ++state.seq;
+    const before = reset ? null : state.next;
+    clearError();
+    setBusy(true);
+    if (reset) { els.skeleton.hidden = false; els.cards.hidden = true; els.empty.hidden = true; els.more.hidden = true; }
+    else els.more.disabled = true;
+    try {
+      const data = await api('GET', '/api/feed?' + feedParams(before));
+      if (seq !== state.seq) return false;
+      if (reset) { els.cards.textContent = ''; state.shown = 0; }
+      const firstNew = els.cards.children.length;
+      appendCards(data.cards);
+      state.next = data.next_before;
+      if (reset) { state.newest = data.newest; hidePill(); }
+      renderEmpty();
+      announce(state.shown === 0 ? 'No stories' : state.shown + (state.shown === 1 ? ' story' : ' stories') + ' shown');
+      if (!reset && els.cards.children[firstNew]) els.cards.children[firstNew].focus();
+      return true;
+    } catch (err) {
+      if (seq !== state.seq) return false;
+      // A failed reset leaves the old cards under the new title: they must not be extendable.
+      if (reset) state.next = null;
+      if (err.status === 401) { askName(); return false; }
+      showError(err.message, () => load(reset));
+      return false;
+    } finally {
+      if (seq === state.seq) {
+        setBusy(false);
+        els.skeleton.hidden = true;
+        els.cards.hidden = false;
+        els.more.disabled = false;
+        els.more.hidden = state.next === null;
+      }
+    }
+  }
+
+  function hidePill() { els.pill.hidden = true; }
+
+  function setView(view) {
+    state.view = view;
+    state.kind = '';
+    state.q = '';
+    els.search.value = '';
+    syncKindChips();
+    for (const b of document.querySelectorAll('.ch[data-view]')) {
+      if (b.getAttribute('data-view') === view) b.setAttribute('aria-current', 'page');
+      else b.removeAttribute('aria-current');
+    }
+    const topic = state.topics.find(t => 'topic:' + t.id === view);
+    els.title.textContent = VIEW_TITLES[view] || (topic ? topic.name : 'Topic');
+    setChannelsOpen(false);
+    return load(true);
+  }
+
+  function syncKindChips() {
+    for (const b of els.kindChips.querySelectorAll('.chip'))
+      b.setAttribute('aria-pressed', b.getAttribute('data-kind') === state.kind ? 'true' : 'false');
+  }
+
+  function setChannelsOpen(open) {
+    els.channels.classList.toggle('open', open);
+    els.channelsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
+  }
+
+  // Where focus goes after a follow change rebuilt the list the user was in: the same control for the
+  // topic if it still exists, else the other follow control for it, else the view's heading.
+  function restoreFollowFocus(id, container) {
+    const sel = '[data-follow="' + String(id).replace(/[^\w-]/g, '') + '"]';
+    const target = container.querySelector(sel) || els.channels.querySelector(sel) || els.empty.querySelector(sel);
+    if (target) target.focus();
+    else els.title.focus();
+  }
+
+  // ----- topics
+  function renderTopics() {
+    els.topicList.textContent = '';
+    if (state.topics.length === 0) {
+      const li = document.createElement('li');
+      li.className = 'side-empty';
+      li.textContent = 'No topics yet';
+      els.topicList.appendChild(li);
+      return;
+    }
+    for (const topic of state.topics) {
+      const li = document.createElement('li');
+      li.className = 'topic-row';
+      const view = document.createElement('button');
+      view.type = 'button';
+      view.className = 'ch';
+      view.setAttribute('data-view', 'topic:' + topic.id);
+      if (state.view === 'topic:' + topic.id) view.setAttribute('aria-current', 'page');
+      const name = document.createElement('span');
+      name.className = 'ch-name';
+      name.textContent = topic.name;
+      const count = document.createElement('span');
+      count.className = 'count';
+      count.textContent = String(topic.stories);
+      count.setAttribute('title', topic.stories + (topic.stories === 1 ? ' story' : ' stories'));
+      view.append(R.icon(document, 'hash'), name, count);
+      const follow = document.createElement('button');
+      follow.type = 'button';
+      follow.className = 'follow';
+      follow.setAttribute('data-follow', topic.id);
+      follow.setAttribute('aria-pressed', topic.following ? 'true' : 'false');
+      follow.setAttribute('aria-label', 'Follow ' + topic.name);
+      follow.appendChild(R.icon(document, 'star'));
+      li.append(view, follow);
+      els.topicList.appendChild(li);
+    }
+  }
+
+  async function loadTopics() {
+    try {
+      state.topics = await api('GET', '/api/topics');
+      renderTopics();
+      const topic = state.topics.find(t => 'topic:' + t.id === state.view);
+      if (topic) els.title.textContent = topic.name;
+    } catch (err) {
+      if (err.status !== 401) showError(err.message, loadTopics);
+    }
+  }
+
+  async function toggleFollow(id) {
+    const topic = state.topics.find(t => String(t.id) === String(id));
+    if (!topic) return;
+    const origin = document.activeElement;
+    try {
+      const data = await api(topic.following ? 'DELETE' : 'POST', '/api/topics/' + encodeURIComponent(id) + '/follow');
+      topic.following = data.following;
+      // The pressed state changes in place, so the focused control survives.
+      for (const b of document.querySelectorAll('[data-follow]'))
+        if (b.getAttribute('data-follow') === String(id)) b.setAttribute('aria-pressed', data.following ? 'true' : 'false');
+      announce((data.following ? 'Following ' : 'Unfollowed ') + topic.name);
+      if (state.view === 'foryou') {
+        // For you is rebuilt from the new follow set; focus returns to the control the user was on.
+        const container = origin && els.empty.contains(origin) ? els.empty : els.channels;
+        await load(true);
+        restoreFollowFocus(id, container);
+      }
+    } catch (err) {
+      if (err.status === 401) askName(); else showError(err.message, () => toggleFollow(id));
+    }
+  }
+
+  // ----- save
+  async function toggleSave(button) {
+    const article = button.closest('article');
+    const id = article.getAttribute('data-id');
+    const saved = button.getAttribute('aria-pressed') === 'true';
+    try {
+      const data = await api(saved ? 'DELETE' : 'POST', '/api/stories/' + encodeURIComponent(id) + '/save');
+      button.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
+      announce(data.saved ? 'Saved' : 'Removed from saved');
+    } catch (err) {
+      if (err.status === 401) askName(); else showError(err.message, () => toggleSave(button));
+    }
+  }
+
+  // ----- status and freshness
+  function describeStatus(status) {
+    state.approved = status.sources.approved;
+    let text = status.last_pass_at ? 'Sources checked ' + R.relativeTime(status.last_pass_at, new Date()) : 'Sources not checked yet';
+    const problems = [];
+    if (status.sources.failing > 0) problems.push(status.sources.failing + (status.sources.failing === 1 ? ' source failing' : ' sources failing'));
+    if (status.loop_error) problems.push('the check reported an error');
+    if (problems.length) text += ' · ' + problems.join(', ');
+    els.freshnessText.textContent = text;
+    els.freshness.classList.toggle('warn', problems.length > 0);
+  }
+
+  async function loadStatus() {
+    try {
+      describeStatus(await api('GET', '/api/status'));
+    } catch (err) {
+      els.freshnessText.textContent = 'Source status unavailable';
+      els.freshness.classList.add('warn');
+    }
+  }
+
+  // ----- new-stories poll. Fail-open by design: a failed poll only means no pill this round; the next
+  // poll tries again, and the feed itself reports its own failures in the error band.
+  async function poll() {
+    if (document.visibilityState === 'hidden' || !state.me || state.newest === null || state.loading) return;
+    loadStatus();
+    try {
+      const snap = {view: state.view, kind: state.kind, q: state.q, newest: state.newest};
+      const params = new URLSearchParams({view: snap.view, after: String(snap.newest)});
+      const data = await api('GET', '/api/feed/new?' + params);
+      const current = state.view === snap.view && state.kind === snap.kind && state.q === snap.q && state.newest === snap.newest;
+      if (current && data.count > 0) {
+        els.pill.textContent = data.count + (data.count === 1 ? ' new story' : ' new stories');
+        if (els.pill.hidden) announce(els.pill.textContent);
+        els.pill.hidden = false;
+      }
+    } catch (err) {
+      console.warn('new-story poll failed:', err.message);
+    }
+  }
+
+  // ----- name
+  function renderMe() {
+    const name = state.me ? state.me.name : null;
+    els.meName.textContent = name || 'Set your name';
+    els.meInitials.textContent = name ? R.initials(name) : '?';
+    const role = state.me && state.me.role;
+    els.meRole.textContent = role || '';
+    els.meRole.hidden = !role;
+  }
+
+  function askName() {
+    els.cancel.hidden = !state.me;
+    els.nameError.hidden = true;
+    els.input.value = state.me ? state.me.name : '';
+    if (!els.dialog.open) els.dialog.showModal();
+    els.input.focus();
+  }
+
+  async function refreshMe() {
+    const me = await api('GET', '/api/me');
+    state.me = me.name ? me : null;
+    renderMe();
+    return state.me;
+  }
+
+  async function start() {
+    const statusDone = loadStatus();
+    try {
+      if (!(await refreshMe())) { askName(); return; }
+    } catch (err) {
+      showError(err.message, start);
+      return;
+    }
+    await loadTopics();
+    await statusDone; // the approved count is known (or known to be unavailable) before the first feed message
+    await setView(state.view);
+  }
+
+  async function submitName(event) {
+    event.preventDefault();
+    const name = els.input.value.trim();
+    if (!name) {
+      els.nameError.textContent = 'Enter a name to continue.';
+      els.nameError.hidden = false;
+      els.input.focus();
+      return;
+    }
+    try {
+      await api('POST', '/api/me', {name});
+    } catch (err) {
+      els.nameError.textContent = err.message;
+      els.nameError.hidden = false;
+      els.input.focus();
+      return;
+    }
+    try {
+      await refreshMe();
+    } catch (err) {
+      els.nameError.textContent = err.message;
+      els.nameError.hidden = false;
+      return;
+    }
+    els.dialog.close();
+    announce('Signed in as ' + state.me.name);
+    // Saved stories and followed topics belong to the name, so everything is read again.
+    await loadTopics();
+    await setView(state.view);
+  }
+
+  // ----- events
+  els.dialog.addEventListener('cancel', event => { if (!state.me) event.preventDefault(); });
+  // Some browsers close a modal dialog on a second Escape even when cancel was prevented.
+  els.dialog.addEventListener('close', () => { if (!state.me) askName(); });
+  els.form.addEventListener('submit', submitName);
+  els.cancel.addEventListener('click', () => els.dialog.close());
+  els.chip.addEventListener('click', askName);
+  els.channelsToggle.addEventListener('click', () => setChannelsOpen(els.channelsToggle.getAttribute('aria-expanded') !== 'true'));
+  document.addEventListener('keydown', event => {
+    if (event.key !== 'Escape' || els.dialog.open || els.channelsToggle.getAttribute('aria-expanded') !== 'true') return;
+    setChannelsOpen(false);
+    els.channelsToggle.focus();
+  });
+  document.addEventListener('click', event => {
+    if (els.channelsToggle.getAttribute('aria-expanded') !== 'true') return;
+    if (els.channels.contains(event.target) || els.channelsToggle.contains(event.target)) return;
+    setChannelsOpen(false);
+  });
+  els.retry.addEventListener('click', () => { if (state.retry) state.retry(); });
+  els.more.addEventListener('click', () => load(false));
+  els.pill.addEventListener('click', async () => {
+    if (await load(true) && els.cards.firstElementChild) els.cards.firstElementChild.focus();
+  });
+
+  els.channels.addEventListener('click', event => {
+    const follow = event.target.closest('[data-follow]');
+    if (follow) { toggleFollow(follow.getAttribute('data-follow')); return; }
+    const view = event.target.closest('[data-view]');
+    if (view) setView(view.getAttribute('data-view'));
+  });
+  els.empty.addEventListener('click', event => {
+    const follow = event.target.closest('[data-follow]');
+    if (follow) toggleFollow(follow.getAttribute('data-follow'));
+  });
+  els.cards.addEventListener('click', event => {
+    const save = event.target.closest('[data-action="save"]');
+    if (save) toggleSave(save);
+  });
+  els.kindChips.addEventListener('click', event => {
+    const chip = event.target.closest('.chip');
+    if (!chip) return;
+    state.kind = chip.getAttribute('data-kind');
+    syncKindChips();
+    load(true);
+  });
+
+  function runSearch() {
+    window.clearTimeout(state.searchTimer);
+    const q = els.search.value.trim();
+    if (q === state.q) return;
+    state.q = q;
+    load(true);
+  }
+  els.search.addEventListener('input', () => {
+    window.clearTimeout(state.searchTimer);
+    state.searchTimer = window.setTimeout(runSearch, SEARCH_DEBOUNCE_MS);
+  });
+  els.search.addEventListener('keydown', event => {
+    if (event.key === 'Enter') { event.preventDefault(); runSearch(); }
+    if (event.key === 'Escape' && els.search.value) { els.search.value = ''; runSearch(); }
+  });
+  document.addEventListener('keydown', event => {
+    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey || els.dialog.open) return;
+    const t = event.target;
+    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
+    event.preventDefault();
+    els.search.focus();
+  });
+  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') poll(); });
+
+  state.pollTimer = window.setInterval(poll, POLL_MS);
+  start();
+})();
diff --git a/tests/browser_cdp_common.cjs b/tests/browser_cdp_common.cjs
new file mode 100644
index 0000000..882d849
--- /dev/null
+++ b/tests/browser_cdp_common.cjs
@@ -0,0 +1,46 @@
+// Shared by the DevTools Protocol drivers (browser_cdp_measure.cjs, browser_signal_driver.cjs): start a headless Chrome with its
+// own profile folder, find its DevTools endpoint, and open a WebSocket whose `send` returns each command's result.
+const { spawn } = require('child_process');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+// Returns {chrome, profile, endpoint}; endpoint is a promise of the ws:// URL, rejected after 20 s.
+function startChrome(chromePath, prefix, extraArgs = []) {
+  const profile = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
+  const chrome = spawn(chromePath, ['--headless=new', '--disable-gpu', '--remote-debugging-port=0', '--user-data-dir=' + profile, '--hide-scrollbars', ...extraArgs, 'about:blank'], { stdio: ['ignore', 'ignore', 'pipe'] });
+  let stderr = '';
+  const endpoint = new Promise((resolve, reject) => {
+    chrome.stderr.on('data', d => {
+      stderr += d;
+      const m = stderr.match(/DevTools listening on (ws:\/\/\S+)/);
+      if (m) resolve(m[1]);
+    });
+    setTimeout(() => reject(new Error('Chrome did not start: ' + stderr.slice(0, 400))), 20000);
+  });
+  return { chrome, profile, endpoint };
+}
+
+// Opens the socket; onEvent, when given, receives every message that is not a command's answer.
+async function connect(endpoint, onEvent) {
+  const ws = new WebSocket(await endpoint);
+  await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject; });
+  let id = 0;
+  const pending = new Map();
+  ws.onmessage = e => {
+    const m = JSON.parse(e.data);
+    if (m.id && pending.has(m.id)) {
+      const [resolve, reject] = pending.get(m.id);
+      pending.delete(m.id);
+      if (m.error) reject(new Error(JSON.stringify(m.error))); else resolve(m.result);
+    } else if (m.method && onEvent) onEvent(m);
+  };
+  const send = (method, params = {}, sessionId) => new Promise((resolve, reject) => {
+    const n = ++id;
+    pending.set(n, [resolve, reject]);
+    ws.send(JSON.stringify({ id: n, method, params, sessionId }));
+  });
+  return { ws, send };
+}
+
+module.exports = { startChrome, connect };

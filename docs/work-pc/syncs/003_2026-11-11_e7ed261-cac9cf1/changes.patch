+def page(
+    root: Path,
+    fake_env: Callable[[dict[str, Any]], None],
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> Iterator[Page]:
+    chrome()  # skips here when there is no browser
+    monkeypatch.setattr(startup, "FORM", FORM)
+    fake_env({"sleep": 30})
+    with _serving(root, tmp_path) as (served, _watcher):
+        yield served
+

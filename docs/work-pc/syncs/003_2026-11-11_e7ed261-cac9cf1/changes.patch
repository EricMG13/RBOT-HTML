+def _raw(svc: Service, request: bytes) -> bytes:
+    with socket.create_connection(("127.0.0.1", svc.server.server_address[1]), timeout=10) as s:
+        s.sendall(request)
+        received = b""
+        while chunk := s.recv(4096):
+            received += chunk
+    return received

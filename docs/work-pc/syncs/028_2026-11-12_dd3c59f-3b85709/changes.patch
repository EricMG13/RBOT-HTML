+    "a maturity that is not a date": lambda: [{**FAC[0], "maturity": "2029-02-30"}, FAC[1]],
+    "duplicate facility names": lambda: [FAC[0], {**FAC[1], "name": "term loan facility"}],
+    "a negative balance": lambda: [{**FAC[0], "balance": "-995000"}, FAC[1]],

+def downside_of(outputs):
+    exact = {"outputs": outputs, "scope_limits": []}
+    files = {
+        **FILES,
+        "forecast_exact.json": json.dumps(exact).encode(),
+        "calculation.json": WITHOUT_HISTORY,
+    }
+    return store.read_cashflow(files, None)[0]
+

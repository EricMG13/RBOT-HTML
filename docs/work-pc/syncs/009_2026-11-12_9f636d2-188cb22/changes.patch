+def _after_listing(monkeypatch, change):
+    real = submissions.listing
+
+    def wrapped(source):
+        got = real(source)
+        if source.name == "source":
+            change(source)
+        return got
+
+    monkeypatch.setattr(submissions, "listing", wrapped)

+# Slice 1 fixtures, reused as they are (pytest registers them by this module's names).
+db = test_signal_ingest.db
+db_a = test_signal_ingest.db_a
+
+
+@contextmanager
+def fresh_db():
+    with tempfile.TemporaryDirectory() as folder:
+        db = open_db(Path(folder))
+        try:
+            yield db
+        finally:
+            db.close()
+

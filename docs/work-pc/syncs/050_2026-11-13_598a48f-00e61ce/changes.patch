+    sock = _raw(svc, (head + 'Content-Length: 50\r\n\r\n{"na').encode())
+    sock.settimeout(10)
+    reply = sock.recv(4096)
+    sock.close()
+    time.sleep(0.2)
+    assert reply.split(b"\r\n")[0].split()[1] == b"400"

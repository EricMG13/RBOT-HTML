+        results = mp.Queue()
+        procs = [
+            mp.Process(target=_open_when_ready, args=(str(root), barrier, results))
+            for _ in range(4)
+        ]
+        for p in procs:
+            p.start()
+        got = [results.get(timeout=60) for _ in procs]
+        for p in procs:
+            p.join(30)

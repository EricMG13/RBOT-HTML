+def real_text(sentence="Nothing changed.", fact="", why="The format differs.", gaps=""):
+    text = REAL_REGISTERS.replace("@@SENTENCE@@", sentence).replace("@@FACT@@", fact)
+    return text.replace("@@WHY@@", why).replace("@@GAPS@@", gaps)

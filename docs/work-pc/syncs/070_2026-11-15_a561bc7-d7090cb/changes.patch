-    if spec is None:
-        if column["kind"] == "h":
-            return unavailable_cell(NO_LINE)
-        return not_modelled_cell() if column["kind"] == "fc" else absent_cell()
-    return CELL_OPS[spec[0]](cell, *spec[1:])

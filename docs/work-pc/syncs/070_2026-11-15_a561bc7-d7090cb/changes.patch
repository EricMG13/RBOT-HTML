-@dataclass(frozen=True)
-class StepChain:
-    """One module's registered journal steps and explicit shared-live capability.
-
-    `steps` is the journal order. The last step settles the module (`settling`: its acceptance
-    is the module's), so it is never repaired within the attempt. `cell` names the module's
-    regression case. `repairable`: the steps whose first rejection is repaired once within the
-    attempt (decision 0008 MC-7 item 2). `prefilled`: per step, the hash-binding kinds Python
-    fills (task 7.0i); such a step binds every earlier step of its chain, in order.
-    `projections`: (consumer, producer) -> what a later step is shown of an earlier one (task
-    7.5), every such pair exactly once, so a dispatch never meets an unlisted pair.
-    `pack_sources`: the steps whose validators check spans against the pack text, the only ones
-    sent SOURCE blocks (task 7.5, R6). Tool loops (task 8.0d; task 8.9, user decision 24 Oct
-    2026: every live step of every module): `tool_steps`, every step except `one_shot` (none in
-    the registry; the one-shot path stays for the differential), run as a tool loop
-    (`live.loop`) with the step's own submit tool and no pre-sent pack SOURCE block.
-    `pack_reads`: the tool steps that read the pack by tool without quoting it (CP-1's narrative
-    and readiness, as 8.0d ran them). The tool set (`tool_sets`) is derived: the pack tools
-    (`search_pack`, `read_pages`) iff the step is in `pack_sources` or `pack_reads`, else
-    submit-only. `extract_tools` (task 8.10b, user decision "A" phase 2): the quoting steps
-    (`pack_sources`) also offered `extract_statements`, the Python-extracted statement lines of
-    the pages they cite. `part_submits` (task 8.11, user decision "B"): the quoting steps whose
-    model-facing submit is split into parts Python assembles (`live.submission.assemble`; CP-1's
-    `financials` only). A record breaking any of these raises ValueError.
-    """
-
-    module_id: str
-    cell: str
-    steps: tuple[str, ...]
-    repairable: frozenset[str] = frozenset()
-    prefilled: Mapping[str, frozenset[str]] = field(default_factory=dict)
-    projections: Mapping[tuple[str, str], str] = field(default_factory=dict)
-    pack_sources: frozenset[str] = frozenset()
-    one_shot: frozenset[str] = frozenset()
-    pack_reads: frozenset[str] = frozenset()
-    extract_tools: frozenset[str] = frozenset()
-    part_submits: frozenset[str] = frozenset()
-    shared_live: bool = True
-
-    @property
-    def settling(self) -> str:
-        return self.steps[-1]
-
-    @property
-    def tool_steps(self) -> frozenset[str]:
-        """The steps the live runner runs as a tool loop: all but `one_shot`."""
-        return frozenset(self.steps) - self.one_shot
-
-    def pairs(self) -> tuple[tuple[str, str], ...]:
-        """Every (later step, earlier step) pair of the chain, in chain order."""
-        return tuple(
-            (consumer, producer)
-            for index, consumer in enumerate(self.steps)
-            for producer in self.steps[:index]
-        )
-
-    def __post_init__(self) -> None:
-        if type(self.shared_live) is not bool:
-            raise ValueError("shared_live must be a bool")
-        name = f"step chain {self.module_id}"
-        if not self.steps:
-            raise ValueError(f"{name} has no steps")
-        if len(set(self.steps)) != len(self.steps):
-            raise ValueError(f"{name} repeats a step: {', '.join(self.steps)}")
-        steps = set(self.steps)
-        if extra := sorted(self.repairable - set(self.steps[:-1])):
-            raise ValueError(
-                f"{name} repairs {', '.join(extra)} within the attempt; only a step before its "
-                f"settling step {self.settling} may be"
-            )
-        if extra := sorted(set(self.prefilled) - steps):

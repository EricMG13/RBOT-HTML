-_PREFIXED = re.compile(rf"[A-Za-z]\s*[{''.join(_SYMBOL_CODE)}]")
-_PREFIXED_RUN = re.compile(rf"[A-Za-z]+\s*[{''.join(_SYMBOL_CODE)}]")

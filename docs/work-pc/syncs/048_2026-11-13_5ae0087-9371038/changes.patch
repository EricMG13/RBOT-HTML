+}
+@media(forced-colors:active){
+  .lf-chip,.lf-on,.lib-card,.lib-live,.mdot>[role=img]{border:1px solid CanvasText}
+  .lf-chip[aria-pressed=true]{outline:2px solid Highlight}
+  .step{border:1px solid CanvasText}.step.done{background:CanvasText}.step.running{background:Highlight}
+}
+
+.lib-block+.hint{margin-top:16px}
+.lc-path{flex:none}.lc-details{min-height:28px;padding:2px 12px}

+  assert.deepEqual(Shapes.hiddenColumns(['Line', 'Reference', 'Code'], 'records', [{cells: ['a', 'REF-1', 'USD']}, {cells: ['b', 'REF-2', 'EUR']}]), [1]);
+  assert.deepEqual(Shapes.columnKinds({headers: ['Line', 'Reference'], rows: [{cells: ['a', 'ROW-1']}]}), ['label', 'id']);

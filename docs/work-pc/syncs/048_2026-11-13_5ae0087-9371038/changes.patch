+    else if (more) { current.limit += PAGE; applyFilter(root); }
+    else toggleTrace(trace);
+    return true;
+  }
+  function handleSearch(input) {
+    current.limit = PAGE;
+    applyFilter(input.closest('.ev'));
+  }

+.hist-dots{min-width:0}
+.hist-links{display:flex;flex-wrap:wrap;gap:4px 22px}
+@media print{
+  .lf,.search-row,.lib-sort,.lib-block .seg,.lib-live .lat{display:none}
+  .lib-block [data-pane=list]{display:none!important}.lib-block [data-pane=cards][hidden]{display:block!important}

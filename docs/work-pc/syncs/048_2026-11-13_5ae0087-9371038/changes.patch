+  .rmark.running .lat i:nth-child(1){animation-delay:0s}.rmark.running .lat i:nth-child(2){animation-delay:.135s}.rmark.running .lat i:nth-child(3){animation-delay:.27s}.rmark.running .lat i:nth-child(6){animation-delay:.405s}

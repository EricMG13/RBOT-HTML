+# 2 ---------------------------------------------------------------------------------------------
+
+
+def test_redirect_off_the_allowlist_is_refused(tmp_path: Path) -> None:
+    net = FakeNet({("www.fca.org.uk", "/x"): (302, {"Location": "https://evil.example/y"}, b"")})
+    reason = refused(make(tmp_path, net).fetch_page("https://www.fca.org.uk/x"))

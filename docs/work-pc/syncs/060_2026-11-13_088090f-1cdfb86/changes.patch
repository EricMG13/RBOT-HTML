+    retained(again.fetch_page("https://www.fca.org.uk/c"))
+    assert [row.url.rsplit("/", 1)[1] for row in weblookup.retained_rows(tmp_path / "run")] == [
+        "a",
+        "b",
+        "c",
+    ]

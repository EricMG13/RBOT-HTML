+    "Δ 1M",
+    "Δ 3M",
+    "Δ 6M",
+    "Δ 1YR",
+    "Δ YTD",
+    "Mid YTM",
+    "Mid 3Y DM",
+)
+PEERS_COLS = (
+    "Group",
+    "Company",
+    "Bloomberg ID",
+    "Loan Type",
+    "Ranking",
+    "Ratings",
+    "Size ($Mn)",
+    "Margin",
+    "Maturity",
+    "Bid",
+    "Ask",
+    "Δ 1M",
+    "Δ YTD",
+    "Mid YTM",
+    "Mid 3Y DM",
+)
+DELTAS = ("Δ 1D", "Δ 1W", "Δ 1M", "Δ 3M", "Δ 6M", "Δ 1YR", "Δ YTD")
+DELTA_MAX_SIXTEENTHS = (2, 4, 8, 16, 24, 32, 32)

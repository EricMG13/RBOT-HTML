+
+def _interest(exact: dict, case: str) -> list[Decimal]:
+    return [D(y["interest"]["amount"]) for y in exact["outputs"][case]["years"]]
+
+
+def test_debt_outside_the_facilities_bears_the_analyst_rate_in_every_case():

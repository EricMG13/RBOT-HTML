+# --- the inputs block states facilities (Task 3) ------------------------------------------------
+# A local builder modelled on forecast_block in tests/test_cpos_launch.py (not importable).
+_CP1 = " ".join(_BASE.values()) + " 400 150 6.00% 3.00% 1.00%"

+    assert _interest(exact, "DOWNSIDE") == [D("41.25"), D("38.28"), D("33.66")]
+    assert _interest(exact, "DOWNSIDE_DRIVERS") == [D("38.5"), D("35.8"), D("31.6")]
+
+
+def test_no_remainder_adds_no_interest():

+    exact = _exact(_CP1 + " 500", facilities=rows)
+    # 500 at 6% (480, 460 after amortisation) + 150 at 7%/6%/4%
+    assert _interest(exact, "REFERENCE") == [D("40.5"), D("37.8"), D("33.6")]
+
+
+def test_a_block_without_facilities_publishes_no_facility_key():
